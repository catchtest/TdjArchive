{"scene_id":17,"code":"RPG17","name":"開封城","before_stage_id":16,"before_chapter":16,"$w":1200,"$h":720,"shops":[{"index":0,"name":"兵器鋪","items":[4,6,18,19,46,48,36,37,56,59,67,68,102,104,115,116,127,129,140,141]},{"index":1,"name":"飾品鋪","items":[158,161,164,155,156,159,165,201,203,205,185,186,190,191]},{"index":2,"name":"雜貨鋪","items":[220,221,222,229,230,231]}],"people":{"$keys":["x","y","animation","initial_hidden"],"$rows":[[180,0,"town-a05dcebae0ae35bf",false],[123,4,"town-231e1ee17aeda9e2",false],[50,44,"town-b3dbb9a24ecffd43",false],[0,109,"town-8287b4de58172ba7",false],[0,120,"town-3df64cc037a084cd",false],[31,161,"town-425d90216f81e641",false],[270,496,"town-ef5d46b91e690bb3",false],[371,455,"town-e63ee6aec0a333dc",false],[182,499,"town-d5da2459e4ff360d",false],[54,553,"town-452d6b26c514d6f3",false],[39,452,"town-938ffc96fe8afe19",false],[92,602,"town-1989a3b815d9ec4d",false],[300,600,"town-5915723865af95d1",false],[223,654,"town-3ff8c5a3f3767eb2",false],[295,626,"town-9a3c777250f99fda",false],[480,483,"town-e3ee4d134b858b8f",false],[972,599,"town-40048f412089da5a",false],[896,602,"town-9b32c123ba528f8f",false],[1170,560,"town-86ca9012d6a262a4",false],[754,531,"town-8e3491b2212853c1",false],[657,395,"town-020ca2b5b6d213a3",false],[482,287,"town-c4f17676df9a656e",false],[558,262,"town-72c117d0e3d2a36e",false],[330,212,"town-27b871a825025f16",false],[478,221,"town-f8049ee3617692d8",false],[786,192,"town-76127606a6a594b1",false],[841,233,"town-9d462c368326fb5b",false],[748,263,"town-0c2eb5a2f9d9fe93",false],[730,129,"town-85134ef2e49dfd86",false],[1024,343,"town-ef0ba55a499ba571",false],[966,216,"town-97d26679ebc992ca",false],[1083,240,"town-35355dd041d86c55",false],[930,315,"town-656201742ebb7573",false]]},"preview_flags":{"88":3},"story_scene":{"backgrounds":[{"group":1,"depth":10000000,"image":{"$m":789}}],"layers":{"$keys":["id","group","animation","x","y","pause","delay","parameter","hidden"],"$rows":[[0,1,{"$":0},180,0,0,2,0,false],[1,1,{"$":1},120,0,0,2,0,false],[2,1,{"$":2},30,24,0,2,0,false],[3,1,{"$":3},0,96,0,2,0,false],[4,1,{"$":4},0,120,0,2,0,false],[5,1,{"$":5},30,144,0,2,0,false],[6,1,{"$":6},270,480,0,2,0,false],[7,1,{"$":7},360,432,0,2,0,false],[8,1,{"$":8},180,456,0,2,0,false],[9,1,{"$":9},30,552,0,2,0,false],[10,1,{"$":10},30,432,0,2,0,false],[11,1,{"$":11},90,600,0,2,0,false],[12,1,{"$":12},270,600,0,2,0,false],[13,1,{"$":13},210,648,0,2,0,false],[14,1,{"$":14},270,624,0,2,0,false],[15,1,{"$":15},480,480,0,2,0,false],[16,1,{"$":16},968,576,0,2,0,false],[17,1,{"$":17},876,602,0,5,0,false],[18,1,{"$":18},1170,552,0,2,0,false],[19,1,{"$":19},750,528,0,2,0,false],[20,1,{"$":20},630,383,0,2,0,false],[21,1,{"$":21},478,264,0,2,0,false],[22,1,{"$":22},540,240,0,2,0,false],[23,1,{"$":23},330,192,0,2,0,false],[24,1,{"$":24},450,216,0,2,0,false],[25,1,{"$":25},780,192,0,2,0,false],[26,1,{"$":26},840,216,0,2,0,false],[27,1,{"$":27},720,240,0,2,0,false],[28,1,{"$":28},720,120,0,2,0,false],[29,1,{"$":29},1020,342,0,2,0,false],[30,1,{"$":30},960,216,0,2,0,false],[31,1,{"$":31},1080,240,0,2,0,false],[32,1,{"$":32},930,312,0,2,0,false]]}},"map":{"$m":789},"doors":[{"shop_index":0,"x":180,"y":456,"$w":30,"$h":24,"event_group":3},{"shop_index":1,"x":990,"y":576,"$w":30,"$h":24,"event_group":4},{"shop_index":2,"x":1020,"y":192,"$w":30,"$h":24,"event_group":5}],"conversations":{"$keys":["id","cells","script"],"$rows":[[6,[[4,0],[4,1]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「浮生半日閒，悠然倚橋邊………不亦快哉。」","side":-1},{"op":0,"args":[]}],{}],[7,[[2,2]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「不知是不是我多心，但我覺得水裡的魚兒這幾天都游得很是惶急，和平常大是不同....」","side":-1},{"op":0,"args":[]}],{}],[8,[[2,3]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我心情不好，不要跟我講話！」","side":-1},{"op":0,"args":[]}],{}],[9,[[3,5]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「女人真是麻煩，明明好端端的，怎麼又鬧起彆扭來了？」","side":-1},{"op":0,"args":[]}],{}],[10,[[6,5]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「這位英挺的少俠，賞幾文錢給小老兒我填填肚子吧！」","side":-1},{"op":0,"args":[]}],{}],[11,[[11,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「現在京城裡的姑娘們，可真是沒幾個看得上眼的。」","side":-1},{"op":0,"args":[]}],{}],[12,[[12,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「眼睛別長在頭頂上。在橋邊看魚的那個妞，我就覺得挺不錯的。」","side":-1},{"op":0,"args":[]}],{}],[13,[[16,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「王大人最近不知道在忙些什麼，這幾天都沒有差遣咱們，想是正在宮中上奏獻言罷。」","side":-1},{"op":0,"args":[]}],{}],[14,[[17,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「嗯，我倒聽說王大人最近常與禁軍的韋統領會面，兩人似在商議什麼大事。」","side":-1},{"op":0,"args":[]}],{}],[15,[[19,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「遺憾得很，俺的偏方靈藥只能治一般病痛雜症，於少俠你們似乎並不合用。」","side":-1},{"op":0,"args":[]}],{}],[16,[[26,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「嗯~~這告示板上貼了好多告示，可是我只看得懂幾個字而已....」","side":-1},{"op":0,"args":[]}],{}],[17,[[28,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「據傳京城中有不軌之徒潛伏，在韋統領的號令之下，現在不單是咱們一般官差，就連京城禁軍也出馬四處巡查，看來上頭著實看重此事。」","side":-1},{"op":0,"args":[]}],{}],[18,[[29,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「如果見到可疑人等，務必立即就近通報官差卒吏，若因此而逮獲不軌之徒，官府必定重重有賞。」","side":-1},{"op":0,"args":[]}],{}],[19,[[32,10]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「對不住老爺，小的下次一定不敢了。」","side":-1},{"op":0,"args":[]}],{}],[20,[[33,10]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我在這兒罵人，你打什麼岔啊？」","side":-1},{"op":0,"args":[]}],{}],[21,[[36,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「在這麼刻薄的老闆手底下工作，還得常挨罵，那年輕人真是可憐。」","side":-1},{"op":0,"args":[]}],{}],[22,[[37,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「真攪不懂這些舊東西怎能值這麼高的價錢？」","side":-1},{"op":0,"args":[]}],{}],[23,[[38,12],[38,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「所謂物以稀為貴，不能再有的東西，自然價值就高了。」","side":-1},{"op":0,"args":[]}],{}],[24,[[31,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我相公真是命苦，工作累人不說，還得老挨這種罵。」","side":-1},{"op":0,"args":[]}],{}],[25,[[35,14]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「昨夜三更之時，又有人聽到祭天塔中冒出詭異妖光，這已經不知道是第幾次了。」","side":-1},{"op":0,"args":[]}],{}],[26,[[34,14]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「自從皇城中建那祭天塔以來，城中怪事迭傳，妖異層出不窮。我看那塔不是建來祭天消災，而是引邪聚戾用的。」","side":-1},{"op":0,"args":[]}],{}],[27,[[22,18]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「在下雖是一介占師，卻也略知公子正身負重責大任。天機難窺，前途未料，希望公子謹步慎行，必可凡事避凶化吉。」","side":-1},{"op":0,"args":[]}],{}],[28,[[23,16]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「莫小看這些古本舊籍，或許可在裏面找到奇珍至寶也說不定。」","side":-1},{"op":0,"args":[]}],{}],[29,[[22,19]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「小女子正在習字練帖，想在這裡找幅名家書帖來當做範本之用。」","side":-1},{"op":0,"args":[]}],{}],[30,[[23,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「唉，現在讀聖賢書沒什麼用啦，瞧那齊祀以一介方士之身被延聘入宮，甚至還被皇上封為國師，我看今後還是改學風水陰陽之道較來得有發展。」","side":-1},{"op":0,"args":[]}],{}],[31,[[23,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「嵩山磐天嶺就是四象門所在，聽說四象門向來精於咒術鬼道，目前京城異象如此嚴重，我想不妨請他們來察看一番，或可找出癥結所在。」","side":-1},{"op":0,"args":[]}],{}],[32,[[24,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「此言倒也有理，只是那四象門作風詭密自封，向來不與他派打交道，要如何請得動他們來此，我看這大有問題。」","side":-1},{"op":0,"args":[]}],{}],[33,[[25,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....再怎麼說我都覺得城裏不怎麼安寧，還是先把阿寶先送到我鄉下娘家一陣子好了。」","side":-1},{"op":0,"args":[]}],{}],[34,[[26,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....啐，娘們都是這麼神經兮兮的麼？現下明明好端端的，卻說城裏不安全，搞不懂她們在想些什麼。」","side":-1},{"op":0,"args":[]}],{}],[35,[[27,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「娘說現在外頭有專抓小孩的鬼怪，所以天一黑就不准我出門。」","side":-1},{"op":0,"args":[]}],{}],[36,[[28,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「唉，管他城裡鬧什麼鬼怪，店裡的生意還是得作啊！」","side":-1},{"op":0,"args":[]}],{}],[37,[[34,26]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「本店新近進貨，應有盡有，進來看看吧！」","side":-1},{"op":0,"args":[]}],{}],[38,[[32,28]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「前些日子又莫名其妙失蹤了好些人，看來官差們的工作這會又要倍增了。」","side":-1},{"op":0,"args":[]}],{}],[39,[[33,28]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「不過據我所知，失蹤的都是一些城中有名的地痞壞胚，如果他們真給妖魔給吃了，那倒也沒什麼不好。」","side":-1},{"op":0,"args":[]}],{}],[40,[[34,28]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....別再說啦，這陣子的怪事還不夠多麼？沈家廢屋的怪聲我都已經懶得提了。」","side":-1},{"op":0,"args":[]}],{}],[41,[[18,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我以前聽人家說過，沈家廢屋底下有個存放祖先靈柩的墓窖，最近的怪事該不會是僵屍怨靈在作怪吧？」","side":-1},{"op":0,"args":[]}],{}],[42,[[19,21]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「既然有那麼多人半夜聽到慘號聲，我看那沈家廢屋裡一定有什麼古怪。」","side":-1},{"op":0,"args":[]}],{}],[43,[[20,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「沒聽過沈家廢屋？那你一定是外地來的了。沈家廢屋就位在客棧東北方的小巷道底，房子早已破廢許久，只因為當年一樁懸案未破，官府遲遲不肯將之拆除，讓大家心裡老是不很安寧。」","side":-1},{"op":0,"args":[]}],{}],[44,[[17,21]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「這些水果看來滿不錯的，就多買一些好了。」","side":-1},{"op":0,"args":[]}],{}],[45,[[20,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「來哦！剛摘回來的水果，便宜又好吃，想買要快哦！」","side":-1},{"op":0,"args":[]}],{}],[46,[[16,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「俺陪我老婆來市集買菜。這娘們聽多了三姑六婆們的怪談，嚇得不管上哪都要找俺一起去，當真是麻煩得緊。」","side":-1},{"op":0,"args":[]}],{}],[47,[[14,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「娘每次上市集都要帶著我，害我都不能跟大寶他們出去玩。」","side":-1},{"op":0,"args":[]}],{}],[48,[[13,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「老闆，給我切半斤五花肉………順便送我一隻豬大骨。」","side":-1},{"op":0,"args":[]}],{}],[49,[[12,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「真是的，挺著個大肚子，作什麼都不方便。」","side":-1},{"op":0,"args":[]}],{}],[50,[[9,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「需要柴火嗎？」","side":-1},{"op":0,"args":[]}],{}],[51,[[7,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「噯，你就別亂想太多了。想想上回那塊怪鐵直到現在都還無法燒鎔，咱們連這個都弄不好，所以只有打尋常兵器的份。」","side":-1},{"op":0,"args":[]}],{}],[52,[[6,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「打了這麼多年的兵器，什麼奇金異鐵多多少少也都打過一些。不過聽說有些兵器的神威超群，並非人手所能造出，若有機會的話，真想弄一把來看看到底神異何在。」","side":-1},{"op":0,"args":[]}],{}],[53,[[11,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....我看問題多半是出在皇城之中，咱們不妨夜探皇宮，或許能尋得一點蛛絲馬跡。」","side":-1},{"op":0,"args":[]}],{}],[54,[[10,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....你這人當真亂來，大內皇宮豈是可以隨便闖的？咱們就再等上幾日，看之後還有什麼動靜再說。」","side":-1},{"op":0,"args":[]}],{}],[55,[[8,27]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「不知我是不是犯了耳鳴症，這幾天每晚聽到哪裡傳來尖細的怪笑聲，害我一直都睡不好覺。呵～好睏....」","side":-1},{"op":0,"args":[]}],{}],[56,[[2,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「就算有了合手的兵器，也得要有一身好武藝才能相得益彰。」","side":-1},{"op":0,"args":[]}],{}],[57,[[2,23],[2,24]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「偷得浮生半日閒，果然是人生一大樂事。」","side":-1},{"op":0,"args":[]}],{}],[58,[[3,26]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我瞧當今皇上極是迷信風水運勢之說，自從那齊祀入宮以來，宮裡興工動土已不只一次，然而城中異象有增無減，這實是諷刺已極。」","side":-1},{"op":0,"args":[]}],{}],[59,[[4,26]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「噯，別忘了此地乃是天子腳下，勸你這種話你還是少說一點，免得無端惹禍上身。」","side":-1},{"op":0,"args":[]}],{}],[60,[[25,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「沒關係，等我長大之後，就可以看懂這些告示上是寫些什麼了。」","side":-1},{"op":0,"args":[]}],{}],[61,[[30,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....汪!汪!」","side":-1},{"op":0,"args":[]}],{}],[62,[[27,24]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「也不知怎的，我一看到那祭天塔就覺得渾身不舒服。」","side":-1},{"op":0,"args":[]}],{}],[63,[[10,4]],{"$keys":["op","args"],"$rows":[[32,[88,4,0,20],{"value":4}],[32,[88,3,0,3],{"value":3}],[0,[],{}],[9,[-1,-1,-1,1],{"text":"咦，這大樹的樹根處好像埋有東西，莫非是襄陽城那對夫婦所說的埋藏之物？嗯，先挖出來看看再說好了。","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,-1],{"text":"發現五面水鏡，五份時幻沙！","side":-1}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[9,[-1,-1,-1,2],{"text":"呵呵，沒想到那對夫婦小時候這麼頑皮，這可都是十分珍罕的寶物呢。反正他們都說用不著了，咱們就借來一用吧。","side":0,"portrait":{"$m":769}}],[9,[-1,-1,-1,1],{"text":"嗯，也好....","side":0,"portrait":{"$m":15}}],[44,[88],{"value":1}],[0,[],{}],[0,[],{}],[9,[-1,-1,-1,1],{"text":"埋在樹下的罈子裡只剩一些小孩子的雜物，就別去動它們好了。","side":0,"portrait":{"$m":15}}],[0,[],{}]],"$extra":true},{"condition":"曾問過襄陽城客棧夫婦、得知樹下藏物且尚未挖取；網站預覽預設已取得線索。"}]],"$extra":true},"transitions":[{"id":2,"cells":[[20,7],[21,7]],"script":[{"op":38,"args":[18]},{"op":0,"args":[]}]}],"story_scripts":[],"exits":[{"id":1,"cells":[[2,0],[3,0],[39,13],[39,14],[39,15],[39,16],[0,27],[0,28],[0,29],[1,29],[2,29],[3,29],[4,29],[5,29]],"script":{"$keys":["op","args"],"$rows":[[46,[1,0,0,0,89],{"text":"確定要就此離城出發嗎？","choices":["是的，就此離城出發。","不，再停留一會兒好了。"]}],[34,[89,1,0,4],{"value":1}],[9,[-1,-1,-1,1],{"text":"既是如此，就多待一會兒好了。","side":0,"portrait":{"$m":15}}],[0,[],{}],[45,[89],{"value":1}],[9,[-1,-1,-1,8],{"text":"咦，殷哥哥，我們要上哪裡去？敵人的下落不是還沒查明嗎？","side":1,"portrait":{"$m":504}}],[9,[-1,-1,-1,2],{"text":"是啊，再說上官大哥也還沒歸隊，不管怎樣，總是先找到他比較妥當。","side":0,"portrait":{"$m":28}}],[9,[-1,-1,-1,1],{"text":"忘了告訴你們了，之前我在客棧結帳時掌櫃遞了封信給我，原來上官大哥早就料到咱們會去那裡投宿，所以預先留書給我們。","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,7],{"text":"啊，原來如此！上官大哥可有說些什麼？","side":1,"portrait":{"$m":463}}],[9,[-1,-1,-1,1],{"text":"上官大哥要我們天黑後到宮內禁軍軍營和他會面。他說他已說動禁軍韋統領和星監王大人著手調查祭天塔，並且正在秘密調集人馬準備夜裡進行包圍，但他為防有變，還是要我們先到宮外待命。","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,3],{"text":"嗯，我瞧祭天塔裡必定藏有妖魔，倘若一舉殺出，只怕禁軍也不會是對手，咱們在宮外待命，萬一有變便可立即赴援，也可少些無辜的死傷。","side":1,"portrait":{"$m":57}}],[9,[-1,-1,-1,1],{"text":"紫楓姑娘說得是，上官大哥正是這個意思。","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,5],{"text":"那咱們還等什麼，這就出發吧！其他的就等和上官老兄碰面之後再說了。","side":1,"portrait":{"$m":52}}],[9,[-1,-1,-1,1],{"text":"嗯！","side":0,"portrait":{"$m":15}}],[40,[],{}],[0,[],{}]],"$extra":true}}],"scene_animation_keys":[{"$":20},{"$":27},{"$":11},{"$":1},{"$":23},{"$":31},{"$":4},{"$":13},{"$":16},{"$":5},{"$":9},{"$":12},{"$":32},{"$":22},{"$":25},{"$":3},{"$":28},{"$":18},{"$":19},{"$":10},{"$":30},{"$":14},{"$":17},{"$":26},{"$":0},{"$":2},{"$":21},{"$":8},{"$":15},{"$":7},{"$":29},{"$":6},{"$":24}],"animation_group":"17","$mediaVersion":"a0d8fb804677","$pool":["a05dcebae0ae35bf22d9f0b9dbd925a7d7a2f3ce8e9eb90663502d6ecaba00e0","231e1ee17aeda9e297188f2acae2f65010d3c1cced9d1e34ab6151ad6e073e2d","b3dbb9a24ecffd439639299bd93ec2995e3af8ff6ac2c6b40f18884be958ea5e","8287b4de58172ba71068b2198dde2d5b041de53bc3eeb159fca9647d84140065","3df64cc037a084cde0c4d5d1936d857dc9332f798688f176b88da58ab85c8bfb","425d90216f81e6411cd3216d19b27a84983d6fda96d555c436fc92fd4c019f24","ef5d46b91e690bb332543cf51ffbbbe729cd2f36c326a574bdc80b8e2753f0a9","e63ee6aec0a333dc18849f86004236b04a1e27a79bf8a07cd1d4d7e4c3fdc2ea","d5da2459e4ff360dd40e2749b2ebbf7a2b27b131b02a48fd0c11a8c4a79a4f70","452d6b26c514d6f35340ec2f3d834b0aa05e0b63ebca5c90c359710f2ca28e4f","938ffc96fe8afe191709030b972f8dbb99ca5bf2651db4aa8a86640282933a4f","1989a3b815d9ec4d33ac14605cb21aad30b9ae23f8f941f187e01cbca5502602","5915723865af95d1d7466d862f118ff645d8bd37056de726b035f2c53a7b46ea","3ff8c5a3f3767eb2e9dce28ef0219bf954dab1508f807dd62ba0e283add622d2","9a3c777250f99fda1c198daf5ddcb2f66234dd2d03a926b592f5e39c4a117b3d","e3ee4d134b858b8ffb8a8055c16f2766c77daebfb3752d10eeec1b8ae633832f","40048f412089da5a738958e47a8ca9a2098fff51564d7b4601e8828443df1ced","9b32c123ba528f8f2d3857d247237863cff5ade3f9a8a3c77b2e6432cecff4d9","86ca9012d6a262a494202874794ed23cbe26a20ae01c835a0cc6cab1dbbd64cc","8e3491b2212853c113a34432264c6191d8c634bec9520923f135a4355de9afe1","020ca2b5b6d213a34c8f4827c29ae721b9b0adc9f10f93b531211aced9d0a302","c4f17676df9a656e69aa301de0880f54d8ef9bd913920e876ebdd1967da02211","72c117d0e3d2a36efd8002f123bc27becd3716ed88abc8d0283dc6970163247a","27b871a825025f162722c597a0bd4f47e52b8217212c0f60f9540a74be37d9ec","f8049ee3617692d8a10c4a288ab7fe8357e49090c1f985e7f56be8529f23de68","76127606a6a594b18dbb3a133363c066f6c91c3bafa1bd33f77bf9c657539b24","9d462c368326fb5bbd576d2c05f114781ce55b59e1f80d76a1fd3f51c483e907","0c2eb5a2f9d9fe93b3642573bb56d0096444f12fd03b835ae74b31061f20e51e","85134ef2e49dfd86ba63084f4988b0ad70135353c9d23e458cb56895073b0f44","ef0ba55a499ba571126a62acab5e1efaef95dceebf35b2397fef845982a9fe4b","97d26679ebc992caf057aec6190fb055b8662c165c162b5cb04542b45362e9b9","35355dd041d86c551347ca4e64d6ff974101c35c56187062f91a1fc370a7525a","656201742ebb75739e2af2bb52ba308394e223187431967852f667f22a830560"]}