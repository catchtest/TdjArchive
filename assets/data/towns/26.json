{"scene_id":26,"code":"RPG26","name":"太原城・事件場景","before_stage_id":8,"before_chapter":8,"parent_scene_id":7,"$w":1050,"$h":432,"shops":[],"people":[],"story_scene":{"backgrounds":[{"group":1,"depth":10000000,"image":{"$m":794}}],"layers":[{"id":0,"group":1,"animation":"34ad80df99d429149979fcfa8af051bac3f78f4755892c3a9230cfa7c18b7bb9","x":319,"y":-3,"pause":2,"delay":3,"parameter":1,"hidden":true}]},"map":{"$m":794},"doors":[],"conversations":[{"id":2,"cells":[[16,1]],"name":"井中異象","script":{"$":0}}],"transitions":[],"story_scripts":[{"id":1,"name":"無形之壁","script":[{"op":9,"args":[-1,-1,-1,1],"text":"這裡當真有無形之壁擋住去路，果然是有咒術在作祟沒錯。","side":0,"portrait":{"$m":15}},{"op":0,"args":[]}]},{"id":2,"name":"井中異象","script":{"$":0}}],"exits":[],"scene_media":{"movement":{},"animations":{"34ad80df99d429149979fcfa8af051bac3f78f4755892c3a9230cfa7c18b7bb9":{"$w":120,"$h":105,"offset":[100,0],"frames":[[0,1936,0,80],[0,1936,0,80],[0,726,0,80],[0,2178,0,80],[0,1452,0,80],[0,1210,0,80],[0,2420,0,80],[0,1815,0,80],[0,968,0,80],[0,1089,0,80],[0,605,0,80],[0,2057,0,80],[0,242,0,80],[0,1573,0,80],[0,1694,0,80],[0,1331,0,80],[0,121,0,80],[0,2541,0,80],[0,484,0,80],[0,847,0,80],[0,0,0,80],[0,363,0,80],[0,2299,0,80],[0,2299,0,80],[0,2299,0,80],[0,2299,0,80]],"pages":[{"$m":796}]}}},"people_animations":[],"$mediaVersion":"a0d8fb804677","$pool":[{"$keys":["op","args"],"$rows":[[21,[1,1],{}],[43,[],{}],[24,[1,1,0,22],{}],[1,[],{}],[9,[-1,-1,-1,1],{"text":"這井似乎有點可疑....","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,2],{"text":"等等，就是這裡！有誰..好像有誰在這裡面作法....","side":0,"portrait":{"$m":782}}],[9,[-1,-1,-1,3],{"text":"嗯，我也感到這井中透出陣陣妖氣，對方應該是在這裡不會錯。","side":0,"portrait":{"$m":57}}],[9,[-1,-1,-1,5],{"text":"好傢伙，原來是躲在這種地方！","side":0,"portrait":{"$m":52}}],[9,[-1,-1,-1,1],{"text":"既是如此，那非得下井一探不可....","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,4],{"text":"嗯，就由我沿著井壁下去看看有沒有什麼密道暗門之類。我從小是隻皮猴子，爬上爬下慣了，這種水井可難不倒我。","side":1,"portrait":{"$m":42}}],[9,[-1,-1,-1,1],{"text":"那就有勞上官大哥了。","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,4],{"text":"這就包在我身上啦，我去也！","side":1,"portrait":{"$m":42}}],[40,[],{}],[0,[],{}]],"$extra":true}]}