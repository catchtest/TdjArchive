{"scene_id":21,"code":"RPG21","name":"開封城","before_stage_id":20,"before_chapter":20,"$w":1200,"$h":720,"shops":[{"index":0,"name":"兵器鋪","items":[6,7,19,23,48,49,37,39,59,58,68,70,78,104,105,116,118,129,130,141,143,148]},{"index":1,"name":"飾品鋪","items":[158,161,164,155,156,159,165,201,203,205,185,186,190,191]},{"index":2,"name":"雜貨鋪","items":[220,221,222,229,230,231]}],"people":{"$keys":["x","y","animation","initial_hidden"],"$rows":[[180,0,"town-a05dcebae0ae35bf",false],[123,4,"town-231e1ee17aeda9e2",false],[50,44,"town-b3dbb9a24ecffd43",false],[0,109,"town-8287b4de58172ba7",false],[0,120,"town-3df64cc037a084cd",false],[31,161,"town-425d90216f81e641",false],[270,496,"town-ef5d46b91e690bb3",false],[371,455,"town-e63ee6aec0a333dc",false],[182,499,"town-d5da2459e4ff360d",false],[54,553,"town-452d6b26c514d6f3",false],[39,452,"town-938ffc96fe8afe19",false],[92,602,"town-1989a3b815d9ec4d",false],[300,600,"town-5915723865af95d1",false],[223,654,"town-3ff8c5a3f3767eb2",false],[295,626,"town-9a3c777250f99fda",false],[480,483,"town-e3ee4d134b858b8f",false],[972,599,"town-40048f412089da5a",false],[896,602,"town-9b32c123ba528f8f",false],[1170,560,"town-86ca9012d6a262a4",false],[754,531,"town-8e3491b2212853c1",false],[657,395,"town-020ca2b5b6d213a3",false],[482,287,"town-c4f17676df9a656e",false],[558,262,"town-72c117d0e3d2a36e",false],[330,212,"town-27b871a825025f16",false],[478,221,"town-f8049ee3617692d8",false],[786,192,"town-76127606a6a594b1",false],[841,233,"town-9d462c368326fb5b",false],[748,263,"town-0c2eb5a2f9d9fe93",false],[730,129,"town-85134ef2e49dfd86",false],[1024,343,"town-ef0ba55a499ba571",false],[966,216,"town-97d26679ebc992ca",false],[1083,240,"town-35355dd041d86c55",false],[930,315,"town-656201742ebb7573",false]]},"preview_flags":{"88":3},"story_scene":{"backgrounds":[{"group":1,"depth":10000000,"image":{"$m":790}}],"layers":{"$keys":["id","group","animation","x","y","pause","delay","parameter","hidden"],"$rows":[[0,1,{"$":0},180,0,0,2,0,false],[1,1,{"$":1},120,0,0,2,0,false],[2,1,{"$":2},30,24,0,2,0,false],[3,1,{"$":3},0,96,0,2,0,false],[4,1,{"$":4},0,120,0,2,0,false],[5,1,{"$":5},30,144,0,2,0,false],[6,1,{"$":6},270,480,0,2,0,false],[7,1,{"$":7},360,432,0,2,0,false],[8,1,{"$":8},180,456,0,2,0,false],[9,1,{"$":9},30,552,0,2,0,false],[10,1,{"$":10},30,432,0,2,0,false],[11,1,{"$":11},90,600,0,2,0,false],[12,1,{"$":12},270,600,0,2,0,false],[13,1,{"$":13},210,648,0,2,0,false],[14,1,{"$":14},270,624,0,2,0,false],[15,1,{"$":15},480,480,0,2,0,false],[16,1,{"$":16},968,576,0,2,0,false],[17,1,{"$":17},876,602,0,5,0,false],[18,1,{"$":18},1170,552,0,2,0,false],[19,1,{"$":19},750,528,0,2,0,false],[20,1,{"$":20},630,383,0,2,0,false],[21,1,{"$":21},478,264,0,2,0,false],[22,1,{"$":22},540,240,0,2,0,false],[23,1,{"$":23},330,192,0,2,0,false],[24,1,{"$":24},450,216,0,2,0,false],[25,1,{"$":25},780,192,0,2,0,false],[26,1,{"$":26},840,216,0,2,0,false],[27,1,{"$":27},720,240,0,2,0,false],[28,1,{"$":28},720,120,0,2,0,false],[29,1,{"$":29},1020,342,0,2,0,false],[30,1,{"$":30},960,216,0,2,0,false],[31,1,{"$":31},1080,240,0,2,0,false],[32,1,{"$":32},930,312,0,2,0,false]]}},"map":{"$m":790},"doors":[{"shop_index":0,"x":180,"y":456,"$w":30,"$h":24,"event_group":3},{"shop_index":1,"x":990,"y":576,"$w":30,"$h":24,"event_group":4},{"shop_index":2,"x":1020,"y":192,"$w":30,"$h":24,"event_group":5}],"conversations":{"$keys":["id","cells","script"],"$rows":[[6,[[4,0],[4,1]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「浮生半日閒，悠然倚橋邊………不亦快哉。」","side":-1},{"op":0,"args":[]}],{}],[7,[[2,2]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「不知是不是我多心，但我覺得水裡的魚兒這幾天都游得很是惶急，和平常大是不同....」","side":-1},{"op":0,"args":[]}],{}],[8,[[2,3]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我心情不好，不要跟我講話！」","side":-1},{"op":0,"args":[]}],{}],[9,[[3,5]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「女人真是麻煩，明明好端端的，怎麼又鬧起彆扭來了？」","side":-1},{"op":0,"args":[]}],{}],[10,[[6,5]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「這位英挺的少俠，賞幾文錢給小老兒我填填肚子吧！」","side":-1},{"op":0,"args":[]}],{}],[11,[[11,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「現在京城裡的姑娘們，可真是沒幾個看得上眼的。」","side":-1},{"op":0,"args":[]}],{}],[12,[[12,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「眼睛別長在頭頂上。在橋邊看魚的那個妞，我就覺得挺不錯的。」","side":-1},{"op":0,"args":[]}],{}],[13,[[16,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「這下可好了，王大人不幸在祭天塔中喪命，咱們今後卻要怎麼辦？」","side":-1},{"op":0,"args":[]}],{}],[14,[[17,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「咱們做下屬的別管那麼多，安靜的等上頭的吩咐便是，韋統領和擎天監自然會處理妥當的。」","side":-1},{"op":0,"args":[]}],{}],[15,[[19,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「遺憾得很，俺的偏方靈藥只能治一般病痛雜症，於少俠你們似乎並不合用。」","side":-1},{"op":0,"args":[]}],{}],[16,[[26,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....啊，我看懂一個字了！右邊上面的那個字是『民』！」","side":-1},{"op":0,"args":[]}],{}],[17,[[28,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「祭天塔在昨晚的一場地震中崩塌，國師齊祀也告下落不明。現在京城中著實是亂得可以....」","side":-1},{"op":0,"args":[]}],{}],[18,[[29,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....其實說亂也僅止於宮中而已，京城還有禁軍和我們負責戌守衛護，城中一切都還算平靜。」","side":-1},{"op":0,"args":[]}],{}],[19,[[32,10]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「對不住老爺，小的下次一定不敢了。」","side":-1},{"op":0,"args":[]}],{}],[20,[[33,10]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我在這兒罵人，你打什麼岔啊？」","side":-1},{"op":0,"args":[]}],{}],[21,[[36,11]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「在這麼刻薄的老闆手底下工作，還得常挨罵，那年輕人真是可憐。」","side":-1},{"op":0,"args":[]}],{}],[22,[[37,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「真攪不懂這些舊東西怎能值這麼高的價錢？」","side":-1},{"op":0,"args":[]}],{}],[23,[[38,12],[38,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「所謂物以稀為貴，不能再有的東西，自然價值就高了。」","side":-1},{"op":0,"args":[]}],{}],[24,[[31,13]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我相公真是命苦，工作累人不說，還得老挨這種罵。」","side":-1},{"op":0,"args":[]}],{}],[25,[[35,14]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「雖然官差們都說祭天塔是毀於一場突其而來的震災，但昨夜我確實看到有個巨大的黑影破塔而出，看到這景像的還不只我一個。」","side":-1},{"op":0,"args":[]}],{}],[26,[[34,14]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「祭天塔忽然倒塌了，連帶上言建造那塔的國師齊祀也下落不明，依我看來，這必定是樁徹頭徹尾的陰謀不會錯。」","side":-1},{"op":0,"args":[]}],{}],[27,[[22,18]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....公子這回重返舊地，遇見的亦是昔日宿敵。覓活路於死境之中，借先人護庇破敵突圍。切記，切記。」","side":-1},{"op":0,"args":[]}],{}],[28,[[23,16]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「莫小看這些古本舊籍，或許可在裏面找到奇珍至寶也說不定。」","side":-1},{"op":0,"args":[]}],{}],[29,[[22,19]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「昨夜裡我被一陣突其而來的地震驚醒，我起來看看到底發生了什麼事，結果正好看到那頭黑龍衝破祭天塔頂飛出。天地良心，昨晚夜色正明，我發誓我看到的確是條黑龍沒錯。」","side":-1},{"op":0,"args":[]}],{}],[30,[[23,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「國師齊祀也在昨晚的巨變中失蹤，他和這次的事情必定脫不了干係。依此看來，當初那些不利於他的傳言想必都是真的....。」","side":-1},{"op":0,"args":[]}],{}],[31,[[23,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「妖邪蹤跡已現，國師齊祀果然是問題所在。眼下已來不及去向他派求援了，咱們得先集合城中的術劍能者，想辦法先擋下敵襲才行。」","side":-1},{"op":0,"args":[]}],{}],[32,[[24,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「可是照昨晚的情況看來，顯然是有人攻上祭天塔頂，破了齊祀的法陣，還逼得他遍露行跡的召出黑龍逃走。既有如此高人在城中，咱們大可不必慌張，只須保持警覺便是。」","side":-1},{"op":0,"args":[]}],{}],[33,[[25,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....你瞧，連建來祭天鎮災用的祭天塔都倒塌了，可見這場災禍已是無法避免。我決定還是先帶著阿寶先娘家去避一避好了....」","side":-1},{"op":0,"args":[]}],{}],[34,[[26,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「欸，老子向來不信神鬼之說，不過是地震震倒一座木塔，什麼大難將至云云，那是我老婆自己想太多了。」","side":-1},{"op":0,"args":[]}],{}],[35,[[27,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「娘說現在外頭有專抓小孩的鬼怪，所以天一黑就不准我出門。」","side":-1},{"op":0,"args":[]}],{}],[36,[[28,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「唉，管他城裡鬧什麼鬼怪，店裡的生意還是得作啊！」","side":-1},{"op":0,"args":[]}],{}],[37,[[34,26]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「本店新近進貨，應有盡有，進來看看吧！」","side":-1},{"op":0,"args":[]}],{}],[38,[[32,28]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....很多人都說昨晚祭天塔倒塌時看到黑龍破塔飛出，只可惜那時我睡得正好，懶的起床看到底是怎麼一回事，結果就沒看到那一幕，真是可惜啊可惜！」","side":-1},{"op":0,"args":[]}],{}],[39,[[33,28]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「虧你平日是咱們這一夥的包打聽，居然會漏看了這等大事。哈哈，果真是貪睡誤事啊。」","side":-1},{"op":0,"args":[]}],{}],[40,[[34,28]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....祭天塔的事也就算了，咱們真正該注意的是，那齊祀究竟逃向何處，以及他是否有在城內進行其他的陰謀。倘若不查明這兩件事，只怕城中的妖異還不會就此結束。」","side":-1},{"op":0,"args":[]}],{}],[41,[[18,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「根據我一位官差朋有友之言，曾有一批妖人躲在沈家廢屋底下，祕密進行一些駭人聽聞的惡事。不過他們是如何在那裡進出而不引起別人注意，那就不得而知了。」","side":-1},{"op":0,"args":[]}],{}],[42,[[19,21]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「既然有那麼多人半夜聽到慘號聲，我看那沈家廢屋裡一定有什麼古怪。」","side":-1},{"op":0,"args":[]}],{}],[43,[[20,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「我曾目睹有人從沈家廢屋裏出來，雖然那時沒看清楚他們的長像，但我想那些傢伙必定和最近的怪事有關。」","side":-1},{"op":0,"args":[]}],{}],[44,[[17,21]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「這些水果看來滿不錯的，就多買一些好了。」","side":-1},{"op":0,"args":[]}],{}],[45,[[20,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「來哦！剛摘回來的水果，便宜又好吃，想買要快哦！」","side":-1},{"op":0,"args":[]}],{}],[46,[[16,23]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「俺陪我老婆來市集買菜。這娘們聽多了三姑六婆們的怪談，嚇得不管上哪都要找俺一起去，當真是麻煩得緊。」","side":-1},{"op":0,"args":[]}],{}],[47,[[14,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「娘每次上市集都要帶著我，害我都不能跟大寶他們出去玩。」","side":-1},{"op":0,"args":[]}],{}],[48,[[13,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「老闆，給我切半斤五花肉………順便送我一隻豬大骨。」","side":-1},{"op":0,"args":[]}],{}],[49,[[12,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「真是的，挺著個大肚子，作什麼都不方便。」","side":-1},{"op":0,"args":[]}],{}],[50,[[9,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「需要柴火嗎？」","side":-1},{"op":0,"args":[]}],{}],[51,[[7,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「噯，你就別亂想太多了。想想上回那塊怪鐵直到現在都還無法燒鎔，咱們連這個都弄不好，所以只有打尋常兵器的份。」","side":-1},{"op":0,"args":[]}],{}],[52,[[6,22]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「打了這麼多年的兵器，什麼奇金異鐵多多少少也都打過一些。不過聽說有些兵器的神威超群，並非人手所能造出，若有機會的話，真想弄一把來看看到底神異何在。」","side":-1},{"op":0,"args":[]}],{}],[53,[[11,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....在祭天塔底藏有黑龍，這已是極為骸人之事，但不知宮中是否還有其他敵方佈下的陰謀毒計？這可得好好查查才行。」","side":-1},{"op":0,"args":[]}],{}],[54,[[10,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....齊祀法力雖強，這回卻也給逼得召龍逃竄，可知已有修為遠在我們之上的高人插手此事，所以咱們還是靜觀為宜，別自己多管閒事了。」","side":-1},{"op":0,"args":[]}],{}],[55,[[8,27]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「昨晚我聽到的是巨獸的嘶吼聲....嘿嘿，不知今晚我還會聽到些什麼？」","side":-1},{"op":0,"args":[]}],{}],[56,[[2,20]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「是以領悟諸般武技，莫不與『迅』『烈』兩者有關。此二者互為體用，乃是天下武術的根本。」","side":-1},{"op":0,"args":[]}],{}],[57,[[2,23],[2,24]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「偷得浮生半日閒，果然是人生一大樂事。」","side":-1},{"op":0,"args":[]}],{}],[58,[[3,26]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「現在宮中忙於處理善後，大部份的事聽說都是禁軍統領韋勝帶人在辦，加上這回揭舉妖邪有功，看來韋統領這會頓成皇上面前的大紅人了。」","side":-1},{"op":0,"args":[]}],{}],[59,[[4,26]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「可不是麼。如果皇上一時高興，說不定會升韋統領為戍京大將，那齊祀裝神弄鬼不成，反倒是大大的幫了韋統領一把。」","side":-1},{"op":0,"args":[]}],{}],[60,[[25,12]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「沒關係，等我長大之後，就可以看懂這些告示上是寫些什麼了。」","side":-1},{"op":0,"args":[]}],{}],[61,[[30,25]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「....汪!汪!」","side":-1},{"op":0,"args":[]}],{}],[62,[[27,24]],[{"op":9,"args":[-1,-1,-1,-1],"text":"「呵呵呵，沒想到那礙眼的祭天塔竟然倒了，這真是件大快我心的事情。」","side":-1},{"op":0,"args":[]}],{}],[63,[[10,4]],{"$keys":["op","args"],"$rows":[[32,[88,4,0,20],{"value":4}],[32,[88,3,0,3],{"value":3}],[0,[],{}],[9,[-1,-1,-1,1],{"text":"咦，這大樹的樹根處好像埋有東西，莫非是襄陽城那對夫婦所說的埋藏之物？嗯，先挖出來看看再說好了。","side":0,"portrait":{"$m":15}}],[9,[-1,-1,-1,-1],{"text":"發現五面水鏡，五份時幻沙！","side":-1}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[47,[],{}],[9,[-1,-1,-1,2],{"text":"呵呵，沒想到那對夫婦小時候這麼頑皮，這可都是十分珍罕的寶物呢。反正他們都說用不著了，咱們就借來一用吧。","side":0,"portrait":{"$m":770}}],[9,[-1,-1,-1,1],{"text":"嗯，也好....","side":0,"portrait":{"$m":15}}],[44,[88],{"value":1}],[0,[],{}],[0,[],{}],[9,[-1,-1,-1,1],{"text":"埋在樹下的罈子裡只剩一些小孩子的雜物，就別去動它們好了。","side":0,"portrait":{"$m":15}}],[0,[],{}]],"$extra":true},{"condition":"曾問過襄陽城客棧夫婦、得知樹下藏物且尚未挖取；網站預覽預設已取得線索。"}]],"$extra":true},"transitions":[{"id":2,"cells":[[20,7],[21,7]],"script":[{"op":38,"args":[22]},{"op":0,"args":[]}]}],"story_scripts":[],"exits":[{"id":1,"cells":[[2,0],[3,0],[39,13],[39,14],[39,15],[39,16],[0,27],[0,28],[0,29],[1,29],[2,29],[3,29],[4,29],[5,29]],"script":{"$keys":["op","args"],"$rows":[[46,[1,0,0,0,89],{"text":"確定要就此離城出發嗎？","choices":["是的，就此離城出發。","不，再停留一會兒好了。"]}],[34,[89,1,0,4],{"value":1}],[9,[-1,-1,-1,1],{"text":"既是如此，就多待一會兒好了。","side":0,"portrait":{"$m":15}}],[0,[],{}],[45,[89],{"value":1}],[9,[-1,-1,-1,1],{"text":"好，那就出發吧！","side":0,"portrait":{"$m":15}}],[40,[],{}],[0,[],{}]],"$extra":true}}],"scene_animation_keys":[{"$":20},{"$":27},{"$":11},{"$":1},{"$":23},{"$":31},{"$":4},{"$":13},{"$":16},{"$":5},{"$":9},{"$":12},{"$":32},{"$":22},{"$":25},{"$":3},{"$":28},{"$":18},{"$":19},{"$":10},{"$":30},{"$":14},{"$":17},{"$":26},{"$":0},{"$":2},{"$":21},{"$":8},{"$":15},{"$":7},{"$":29},{"$":6},{"$":24}],"animation_group":"17","$mediaVersion":"59962a5fdec5","$pool":["a05dcebae0ae35bf22d9f0b9dbd925a7d7a2f3ce8e9eb90663502d6ecaba00e0","231e1ee17aeda9e297188f2acae2f65010d3c1cced9d1e34ab6151ad6e073e2d","b3dbb9a24ecffd439639299bd93ec2995e3af8ff6ac2c6b40f18884be958ea5e","8287b4de58172ba71068b2198dde2d5b041de53bc3eeb159fca9647d84140065","3df64cc037a084cde0c4d5d1936d857dc9332f798688f176b88da58ab85c8bfb","425d90216f81e6411cd3216d19b27a84983d6fda96d555c436fc92fd4c019f24","ef5d46b91e690bb332543cf51ffbbbe729cd2f36c326a574bdc80b8e2753f0a9","e63ee6aec0a333dc18849f86004236b04a1e27a79bf8a07cd1d4d7e4c3fdc2ea","d5da2459e4ff360dd40e2749b2ebbf7a2b27b131b02a48fd0c11a8c4a79a4f70","452d6b26c514d6f35340ec2f3d834b0aa05e0b63ebca5c90c359710f2ca28e4f","938ffc96fe8afe191709030b972f8dbb99ca5bf2651db4aa8a86640282933a4f","1989a3b815d9ec4d33ac14605cb21aad30b9ae23f8f941f187e01cbca5502602","5915723865af95d1d7466d862f118ff645d8bd37056de726b035f2c53a7b46ea","3ff8c5a3f3767eb2e9dce28ef0219bf954dab1508f807dd62ba0e283add622d2","9a3c777250f99fda1c198daf5ddcb2f66234dd2d03a926b592f5e39c4a117b3d","e3ee4d134b858b8ffb8a8055c16f2766c77daebfb3752d10eeec1b8ae633832f","40048f412089da5a738958e47a8ca9a2098fff51564d7b4601e8828443df1ced","9b32c123ba528f8f2d3857d247237863cff5ade3f9a8a3c77b2e6432cecff4d9","86ca9012d6a262a494202874794ed23cbe26a20ae01c835a0cc6cab1dbbd64cc","8e3491b2212853c113a34432264c6191d8c634bec9520923f135a4355de9afe1","020ca2b5b6d213a34c8f4827c29ae721b9b0adc9f10f93b531211aced9d0a302","c4f17676df9a656e69aa301de0880f54d8ef9bd913920e876ebdd1967da02211","72c117d0e3d2a36efd8002f123bc27becd3716ed88a