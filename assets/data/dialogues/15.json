,"units":{"$":96},"step":76,"base":"overview"},{"line":24}],[{"background":1,"camera":[10,1],"layers":{"$":99},"units":{"$":96},"step":77,"base":"overview"},{"line":25}],[{"background":1,"camera":[10,1],"layers":{"$":99},"units":{"$":96},"step":79,"base":"overview"},{"line":26}],[{"background":1,"camera":[10,1],"layers":{"$":99},"units":{"$":100},"step":86,"base":"overview"},{"line":27}],[{"background":1,"camera":[10,1],"layers":{"$":99},"units":{"$":100},"step":87,"base":"overview"},{"line":28}]],"$extra":true}}],["event-2-path-1","kill","鬼魄屍王被擊倒（曾擊倒夏侯儀、24回合內且破禁後4回合內）",[{"$":158},{"label":"曾擊倒夏侯儀、24回合內且破禁後4回合內"}],[{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"這魔骸終於就此長眠了....大家都沒事吧？","portrait":{"$m":530}},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":{"$":159},"portrait":{"$m":487}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"若非那位夏侯兄捨命破除屍王身上的煉血禁制，咱們早就都橫屍於此了。紫楓姑娘和封姑娘說得沒錯，他的確不是壞人，只可惜當年究竟是什麼事讓他遺恨終身，我們永遠都不會知道，也永遠都無法幫他解開這個心結了。","portrait":{"$m":483}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"其實還不太遲....殷公子，如果我能讓夏侯兄復生，你以為如何呢？","portrait":{"$m":531}},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"以凡身使用非天、絕天禁法，立即魂魄滅散而死，紫楓姐姐，這還能救嗎？","portrait":{"$m":489}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"他的魂魄此刻還繚繞於此，並未完全消散。我這裡有一件名叫『定魂珠』的仙界法寶，可以收他的魂魄後送回肉身，如此便可讓他復生。然而此人是正是邪尚在未知，倘若他復生之後仍為我敵，那便不必為此浪費這件法寶。","portrait":{"$m":531}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"原來如此。紫楓姑娘，妳的意思是....","portrait":{"$m":478}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"到底要不要讓他復生，就看殷公子你的意思。","portrait":{"$m":531}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"我們的性命都是夏侯兄救的，即使他今後繼續與我們為敵，咱們也不能因此就不顧念他的救命之恩。紫楓姑娘，請妳救這位夏侯兄的性命。","portrait":{"$m":478}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"....謹遵所囑。","portrait":{"$m":531}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"殷公子，那我這就開始收魂入魄之儀了。","portrait":{"$m":530}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"有勞紫楓姑娘了。","portrait":{"$m":478}},{"speaker":"真胤","speaker_key":"face:6","side":1,"text":"了得了得！中土的仙術果然是精湛無比，紫楓姑娘這一手收聚散魂的返命神技，真是讓貧僧開了眼界。","portrait":{"$m":551}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"....我還活著？我還活著？","portrait":{"$m":547}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"是這位姑娘用定魂珠收回你四散的魂魄。","portrait":{"$m":478}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"....為何救我？","portrait":{"$m":547}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"是夏侯兄捨命用禁法擊破屍王的護身禁制，我們才得以倖存。這份恩情焉能不報？","portrait":{"$m":486}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"是我自己高興用禁法的，可不是為了救你們！你們的生死才不干我的事！","portrait":{"$m":548}},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"夏侯大哥，我雖不知你為何加入四邪一夥，但你裝兇假惡一點都不像。紫楓姐姐說得對，你打從心裡就不是壞人，只是因為深恨正派諸人，所以才自居邪名，我說的對吧？","portrait":{"$m":487}},{"$":160},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"只有一件事我不明白，那就是為何你願代替我用禁法而死？莫說你和我們原先乃是敵人，即使你內心良善，然而我們非親非故，你也沒道理為我們捨命啊。","portrait":{"$m":487}},{"$":160},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"我知道你過去必有許多傷心之事，你不想提也沒關係。只是經過了這許多事之後，如今我們是友非敵，再無兵刃相向之理。既然你並非真心為惡，只希望你莫再回到四邪那邊，徒然讓我們為難。","portrait":{"$m":487}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"就算鄲陰知道我未死，四邪也不會再相信我了。哼，我本以為死了一了百了，哪知你們多此一舉，我無端端撿回這條命，卻不知道以後該作些什麼。","portrait":{"$m":547}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"夏侯兄術法修為十分高明，何必如此自輕自棄？若夏侯兄不嫌我們本領低微，不如加入我們一夥，一起追討四邪如何？","portrait":{"$m":478}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"你....你要邀我入夥？","portrait":{"$m":548}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"正是。","portrait":{"$m":478}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"哈哈哈哈......有趣！有趣！你要邀我入夥？你要邀我這個不久前還在和你們拼死廝殺的敵人入夥？","portrait":{"$m":547}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"殷少俠既然肯請我將這件仙界法寶用諸於你，自是不再存心追溯既往。","portrait":{"$m":531}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"哼，既然你們能信得過我，反正我今後尚無打算，暫且跟著你們亦無不可。不過我話先說在前面，我擅用的乃是魔道邪法，兼之個性喜怒無常，和正派行事大異其趣，以後若出了什麼事可別怨我。","portrait":{"$m":547}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"這個在下自然明白。作法原不需拘泥於正邪之分，只要發自善心便成。夏侯兄乃是個明理之人，我想今後一切自無問題。","portrait":{"$m":478}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"哼！多言無益，現在該當如何，還請示下。","portrait":{"$m":547}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"自是追索剛才逃走的鄲陰了。咱們趕快從那門追出去看看，或許還能找到他的蹤跡。至於有關四邪的種種，路上再逐一向夏侯兄請教。","portrait":{"$m":478}},{"speaker":"夏侯儀","speaker_key":"face:9","side":0,"text":"那就遵聽隨便了。要走就快走吧！","portrait":{"$m":547}}],{"steps":[{"$":101},{"line":0,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":39,"base":"overview"}},{"line":1,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":40,"base":"overview"}},{"line":2,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":41,"base":"overview"}},{"line":3,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":42,"base":"overview"}},{"line":4,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":43,"base":"overview"}},{"line":5,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":44,"base":"overview"}},{"line":6,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":45,"base":"overview"}},{"line":7,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":46,"base":"overview"}},{"line":8,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":47,"base":"overview"}},{"line":9,"scene":{"background":1,"camera":[8,3],"layers":{"$":140},"units":{"$":141},"effects":{"$":149},"step":48,"base":"overview"}},{"visual_only":true,"scene":{"background":1,"camera":[8,3],"layers":[{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"id