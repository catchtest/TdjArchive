9}],["殷劍平","face:1",1,"....嗯！",{"$m":384}],["殷劍平","face:1",1,"多謝前輩指引，晚輩才能如願尋得神劍。晚輩必將神劍妥加保管，等此事一經解決，自當再將神劍奉還。",{"$m":376}],["劍聖","face:11",1,"神劍歸你乃是天命註定，這早在我意料之中，如今讓我擔心的卻是另外一件事情。",{"$m":420}],["紫楓","face:3",1,"這可奇了，是什麼事情能讓你如此擔心？",{"$m":429}],["劍聖","face:11",1,"在你們來此之前，我曾排卦推算今後吉凶。前卦顯示神劍將歸其主，此為吉兆，但後卦卦象渾沌不明，且有血光凶剋四方，顯然殷少俠在得劍之後將會遭遇極大凶險，而且這凶險與他命緣交纏，乃是難逃之厄。",{"$m":420}],["紫楓","face:3",1,"與殷公子命緣相纏的兇險....莫非是？！",{"$m":430}],["劍聖","face:11",1,"妳也明白就好。我能幫的就到此為止，之後他能否度過這段兇險，就有勞妳多費心了。",{"$m":420}],["紫楓","face:3",1,"....嗯，我會盡力而為的。",{"$m":428}],["殷劍平","face:1",1,"....紫楓姑娘？妳和前輩剛才所談的是....",{"$m":381}],["紫楓","face:3",1,"啊，那只是卦象隱喻，不必在意。殷公子，神劍既已到手，在此地多留無益，咱們找個地方好好歇息，再想辦法尋找封姑娘的下落。",{"$m":428}],["殷劍平","face:1",1,"嗯，就這麼辦吧！",{"$m":376}]]}}],"$mediaVersion":"2dc3ef89874e","$pool":[[{"$":1},{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"$":7},{"$":8}],{"id":0,"direction":2,"x":13,"y":35,"visible":true,"group":1},{"id":1,"direction":2,"x":14,"y":35,"visible":true,"group":1},{"id":2,"direction":2,"x":15,"y":35,"visible":true,"group":1},{"id":3,"direction":2,"x":13,"y":37,"visible":true,"group":1},{"id":4,"direction":2,"x":14,"y":36,"visible":true,"group":1},{"id":5,"direction":2,"x":13,"y":36,"visible":true,"group":1},{"id":6,"direction":2,"x":15,"y":36,"visible":true,"group":1},{"id":7,"visible":true,"group":1,"direction":2,"x":15,"y":37},[{"$":1},{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"$":7},{"$":8},{"id":8,"visible":true,"group":1},{"id":9,"visible":true,"group":1},{"id":10,"visible":true,"group":1},{"id":11,"visible":true,"group":1},{"id":12,"visible":true,"group":1},{"id":13,"visible":true,"group":1},{"id":14,"visible":true,"group":1},{"id":15,"visible":true,"group":1},{"id":16,"visible":true,"group":1},{"id":17,"visible":true,"group":1},{"id":18,"visible":true,"group":1}],{"id":8,"visible":false},{"id":9,"visible":false},{"id":10,"visible":false},{"id":11,"visible":false},{"id":12,"visible":false},{"id":13,"visible":false},{"id":14,"visible":false},{"id":15,"visible":false},{"id":17,"visible