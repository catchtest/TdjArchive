ackground":1,"camera":[5,4],"layers":{"$":36},"units":{"$":40},"step":78,"base":"overview"},{"line":19}],[{"background":1,"camera":[5,4],"layers":{"$":36},"units":{"$":40},"step":79,"base":"overview"},{"line":20}],[{"background":1,"camera":[5,4],"layers":{"$":36},"units":[{"$":38},{"$":39},{"$":26},{"$":27},{"$":28},{"$":29},{"$":30},{"$":31},{"$":10},{"$":11},{"$":12},{"$":13},{"$":14},{"$":15},{"$":16},{"$":17},{"$":41},{"$":18},{"$":19},{"$":20}],"step":82,"base":"overview"},{"line":21}],[{"background":1,"camera":[5,4],"layers":{"$":36},"units":{"$":42},"step":84,"base":"overview"},{"line":22}],[{"background":1,"camera":[5,4],"layers":{"$":36},"units":{"$":42},"step":85,"base":"overview"},{"line":23}],[{"background":1,"camera":[5,4],"layers":{"$":36},"units":{"$":42},"tint":[0,0,0,16],"step":86,"base":"overview","tint_animation":{"$":22}},{"visual_only":true}],[{"background":1,"camera":[5,4],"layers":{"$":36},"units":{"$":42},"tint":[0,0,0,0],"step":90,"base":"overview","$ms":240},{"visual_only":true}]],"$extra":true},"next_scene":"battle:28","conditions":[{"label":"劍聖被擊倒"}],"lines":{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["劍聖","face:11",0,"且住！這場比試就到此為止，不用再打下去了。",{"$m":415}],["殷劍平","face:1",1,"....前輩？",{"$m":341}],["劍聖","face:11",0,"算我服了你們。紫楓果然沒有看錯....你們身為一介凡人，並無仙籍神力可資憑藉，但你們卻有如此的膽識與熱忱，願為一件看似遙不可及的事情獻身盡力。的確，像你們這樣的勇士，才是真正可以託付神劍的人。",{"$m":415}],["殷劍平","face:1",1,"哪裡，我們才要多謝前輩承讓之情。所謂仙俗有別，我們原不該僭越這本分，剛才多所得罪，還望前輩見諒。",{"$m":346}],["劍聖","face:11",0,"你們既已勝了，便不需再多言客氣。取劍吧！",{"$m":415}],["殷劍平","face:1",1,"是。",{"$m":341}],["上官遠","face:4",1,"這就是九儀天尊之劍麼？嗯，此劍形貌古樸威嚴、外泛殷然青光，所謂天地神兵之尊，果不尋常。",{"$m":379}],["紫楓","face:3",1,"是的。恭喜殷公子，這的確就是九儀天尊之劍。",{"$m":434}],["劍聖","face:11",1,"數千年前，黃帝因為神劍沾染魔血不詳，因此封劍於斯。這回為了剋制蚩尤復生，不得已讓神劍再次現世，但是否會有禍事因此而生，那是誰也不知。殷少俠，你要得取此劍之前，可要有此覺悟。",{"$m":415}],["殷劍平","face:1",1,"晚輩明白。",{"$m":341}],["劍聖","face:11",1,"嗯，先前我已將劍印開解，之後就看劍接不接受你了。去取劍吧。",{"$m":415}],["殷劍平","face:1",1,"....啊！",{"$m":357}],["紫楓","face:3",1,"殷公子，可喜可賀，看來神劍已經認你為主了。",{"$m":434}],["殷劍平","face:1",1,"....嗯！",{"$m":357}],["殷劍平","face:1",1,"多謝前輩指引，晚輩才能如願尋得神劍。晚輩必將神劍妥加保管，等此事一經解決，自當再將神劍奉還。",{"$m":341}],["劍聖","face:11",1,"神劍歸你乃是天命註定，這早在我意料之中，如今讓我擔心的卻是另外一件事情。",{"$m":415}],["紫楓","face:3",1,"這可奇了，是什麼事情能讓你如此擔心？",{"$m":434}],["劍聖","face:11",1,"在你們來此之前，我曾排卦推算今後吉凶。前卦顯示神劍將歸其主，此為吉兆，但後卦卦象渾沌不明，且有血光凶剋四方，顯然殷少俠在得劍之後將會遭遇極大凶險，而且這凶險與他命緣交纏，乃是難逃之厄。",{"$m":415}],["紫楓","face:3",1,"與殷公子命緣相纏的兇險....莫非是？！",{"$m":435}],["劍聖","face:11",1,"妳也明白就好。我能幫的就到此為止，之後他能否度過這段兇險，就有勞妳多費心了。",{"$m":415}],["紫楓","face:3",1,"....嗯，我會盡力而為的。",{"$m":433}],["殷劍平","face:1",1,"....紫楓姑娘？妳和前輩剛才所談的是....",{"$m":346}],["紫楓","face:3",1,"啊，那只是卦象隱喻，不必在意。殷公子，神劍既已到手，在此地多留無益，咱們找個地方好好歇息，再想辦法尋找封姑娘的下落。",{"$m":433}],["殷劍平","face:1",1,"嗯，就這麼辦吧！",{"$m":341}]]}}],"scene_media":{"movement":{"1":{"animation":"b930a270e07ee291ba798b44ed2a2d1175920240156cf3c2284a93800b6ae021","phases":{"walk":[0,4],"start":[16,11],"end":[60,10]},"gallery_bounds":{"moving":[[12,0,42,48],[9,0,40,48],[0,0,44,48],[3,0,40,48]]}},"3":{"animation":"1cdb68fa32d7c9695d7f37da7b1cc6ac759e5f52103674575ce38d59107af14b","phases":{"walk":[0,10]},"gallery_bounds":{"moving":[[1,1,33,43],[2,0,32,44],[0,2,33,43],[2,0,32,44]]}},"4":{"animation":"a85680783cb357dba8665b051405a85b9d82ebc9cb4e448e3effae8ebe2bb676","phases":{"walk":[0,4]},"gallery_bounds":{"moving":[[25,0,44,73],[8,12,80,51],[20,6,42,57],[0,12,80,51]]}},"5":{"animation":"6799fc59856fdb77c8738e4b316fee5899ff37bd13c182bf00fe24c157f147ad","phases":{"walk":[0,8]},"gallery_bounds":{"moving":[[0,3,79,52],[16,0,42,55],[4,2,79,53],[22,0,42,55]]}},"6":{"animation":"5d92a001e63de489a0d7a26434d094cbbe58c09d1bd6024558b6b70cd161abd6","phases":{"walk":[0,4]},"gallery_bounds":{"moving":[[0,0,58,45],[0,1,56,43],[10,0,77,45],[16,1,56,43]]}},"7":{"animation":"6a40e3608bbe8be5ce2e1ab20831af991cd2d631a56f4f73cdf49363423e475d","phases":{"walk":[0,4]},"gallery_bounds":{"moving":[[1,0,33,42],[4,1,33,40],[2,0,37,42],[0,0,33,40]]}},"8":{"animation":"90a309594168d17340e0374a8c2c9cd8f0bc5104176dda8366328c7f5bf8abde","