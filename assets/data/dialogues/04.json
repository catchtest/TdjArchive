個性溫馴的靈獸，不過不太和人打交道，所以....噯，怎麼一直在往我的懷裡嗅著，像是要找什麼的樣子....",{"$m":472}],["殷劍平","face:1",1,"啊，莫非是我們那天買的紫霜雲芝？",{"$m":463}],["封寒月","face:2",1,"啊，我倒沒想到！",{"$m":472}],["封寒月","face:2",1,"....來，你要的是這個麼？",{"$m":480}],["靈鼩","face:15",0,"...吱吱！吱吱吱！",{"$m":503}],["封寒月","face:2",1,"哎呀！這貪心的小東西，我只是讓你看看而已，你竟然把雲芝給吃掉了！",{"$m":480}],["殷劍平","face:1",1,"沒關係，反正那雲芝馬上就沒藥效了，就算是用來和牠交個朋友吧。",{"$m":463}],["靈鼩","face:15",0,"咯！....咕吱？....",{"$m":503}],["上官遠","face:4",1,"咦，那小東西看來有點奇怪，莫非是醉了？",{"$m":483}],["封寒月","face:2",1,"喝醉？....難道是吃了這雲芝的結果？",{"$m":474}],["殷劍平","face:1",1,"糟糕，咱們可顧不了牠，既是如此，先打過了眼前這場仗再說。",{"$m":463}],["封寒月","face:2",1,"嗯！",{"$m":472}]]},{"region_ids":[9]}],["event-9","kill","靈鼩被擊倒",[{"line":0,"scene":{"background":1,"camera":null,"focus":[23,8],"layers":[],"units":[],"step":0,"base":"overview"}},{"line":1,"scene":{"background":1,"camera":null,"focus":[23,8],"layers":[],"units":[],"step":1,"base":"overview"}},{"line":2,"scene":{"background":1,"camera":null,"focus":[23,8],"layers":[],"units":[],"step":2,"base":"overview"}}],[{"label":"靈鼩被擊倒"}],[{"speaker":"旁白","speaker_key":null,"side":-1,"text":"吱吱！吱吱！"},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"那小東西受傷了?","portrait":{"$m":474}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"沒有，我想只是受到驚嚇而已，我們還是先解決眼前的敵人罷了！","portrait":{"$m":463}}],{}]],"$extra":true},"$mediaVersion":"71ad2e47eeb4","$pool":[[{"id":0,"frame":1,"mode":"held"}],[{"$":2},{"id":2,"x":2,"y":23,"visible":true,"group":1,"direction":2},{"$":3}],{"id":0,"x":3,"y":22,"visible":true,"group":1,"direction":2},{"id":3,"x":4,"y":23,"visible":true,"group":1,"direction":2},[{"$":2},{"$":5},{"$":3}],{"id":2,"x":2,"y":23,"visible":true,"group":1,"direction":3},[{"$":7},{"$":5},{"$":8}],{"id":0,"x":3,"y":22,"visible":true,"group":1,"direction":3},{"id":3,"x":4,"y":23,"visible":true,"group":1,"direction":3},[{"$":10}],{"id":0,"frame":8,"mode":"held"},[{"$":10},{"$":12}],{"id":3,"frame":0,"mode":"loop"},[{"$":7},{"$":5},{"$":8},{"$":14},{"$":15},{"$":16},{"$":17}],{"id":4,"v