e":{"background":1,"camera":null,"focus":[34,6],"layers":[],"units":[],"step":5,"base":"overview"}}],{"$keys":["label"],"$rows":[[{"$":58}],["第22回合・我方行動前"],["第24回合・我方行動前"],["第26回合・我方行動前"],["第28回合・我方行動前"],["第30回合・我方行動前"],["第32回合・我方行動前"]]},[{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"混元寶塔的護力越來越弱了，我們得快點才行！","portrait":{"$m":535}}],{}],["event-4","turn",{"$":59},[{"line":0,"scene":{"background":1,"camera":null,"focus":[34,6],"layers":[],"units":[],"step":1,"base":"overview"}}],[{"label":{"$":59}}],[{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"混元寶塔....失去效力了....","portrait":{"$m":535}}],{}],["event-2","victory","戰鬥勝利",[{"line":0,"scene":{"background":1,"camera":[19,21],"layers":[],"units":{"$":60},"step":24,"base":"overview"}},{"line":1,"scene":{"background":1,"camera":[19,21],"layers":[],"units":{"$":60},"step":25,"base":"overview"}},{"line":2,"scene":{"background":1,"camera":[19,21],"layers":[],"units":{"$":60},"step":26,"base":"overview"}}],[{"label":"戰鬥勝利：敵方全滅"}],[{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"好，待會兒大夥就從洞口逐一縋下洞底。先由三個人下去探看狀況，如果沒有妖魔出沒的話就搖晃繩索為訊，頂上的人再全部下去。各位以為如何？","portrait":{"$m":478}},{"speaker":"上官遠","speaker_key":"face:4","side":1,"text":"此計不錯，鮮于老兄，真胤大師，就咱們三個打頭陣了。","portrait":{"$m":498}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"那就有勞三位了。","portrait":{"$m":530}}],{"next_scene":"battle:25"}]],"$extra":true},"$mediaVersion":"4c29e4788a96","$pool":[[{"$":1}],{"id":8,"visible":true,"group":2},[{"id":0,"animation":{"$":3},"depth":20000000,"origin":{"camera":[12,8]},"frame":0,"end":0,"mode":"held"}],"aa8b4998ed50fd196a668840ad5e3bc3d95f7467d2fcc4bd96292f66a46212f1","085e5a281689c51feda9b89ecaf03e2dcab2a75ac74a3bae2c79d32912e1372c",[{"id":0,"animation":{"$":4},"depth":20000000,"origin":{"camera":[22,12]},"frame":171,"end":171,"mode":"held"}],{"id":9,"visible":true,"group":1},{"id":10,"visible":true,"group":1},{"id":11,"visible":true,"group":1},{"id":12,"visible":true,"group":1},{"id":13,"visible":true,"group":1},{"id":14,"visible":true,"group":1},{"id":15,"visible":true,"group":1},{"id":16,"visible":true,"group":1},{"id":17,"visible":true,"group":1},{"id":18,"visible":true,"group":1},{"id":19,"visible":true,"group":1},{"id":20,"visible":true,"group":1},{"id":21,"visible":true,"group":1},{"id":22,"visible":true,"group":1},{"id":23,"visible":true,"group":1},{"id":24,"visible":true,"group":1},{"id":25,"visible":true,"group":1},{"id":26,"visible":true,"group":1},{"id":27,"visible":true,"group":1},{"id":28,"visible":true,"group":1},{"id":29,"visible":true,"group":1},{"id":30,"visible":true,"group":1},{"id":31,"visible":true,"group":1},{"id":32,"visible":true,"group":1},{"id":33,"visible":true,"group":1},{"id":34,"visible":true,"group":1},{"id":35,"visible":true,"group":1},{"id":36,"visible":true,"group":1},{"id":37,"visible":true,"group":1},{"id":38,"visible":true,"group":1},{"id":39,"visible":true,"group":1},{"id":40,"visible":true,"group":1},{"id":41,"visible":true,"group":1},{"id":42,"visible":true,"group":1},{"id":43,"visible":true,"group":1},{"id":44,"visible":true,"group":1},{"id":45,"visible":true,"group":1},{"id":46,"visible":true,"group":1},{"id":47,"visible":true,"group":1},{"id":48,"visible":true,"group":1},{"id":49,"visible":true,"group":1},{"id":50,"visible":true,"group":1},{"id":51,"visible":true,"group":1},{"id":52,"visible":true,"group":1},{"id":53,"visible":true,"group":1},{"id":54,"visible":true,"group":1},{"label":"戰鬥前的開場劇情"},[{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"從這裡確實可以看到遠方火山冒出的濃煙，我想前輩所說的雪山之顛應該就是這裡不會錯。","portrait":{"$m":478}},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"如今一切已整備妥當，也差不多是出發的時候了。殷大哥，魂翔之玉和珍瓏鏡玉都準備好了麼？","portrait":{"$m":487}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"嗯，現下萬事皆備，就剩珍瓏鏡玉的效用還沒試過，不知那縮型之咒是否管用。","portrait":{"$m":478}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"我想那位前輩所知博瀚，既然咱們都煉出了珍瓏鏡玉，想必那縮型之咒不會假。","portrait":{"$m":530}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"好，請大家閉目凝神、抱虛守元，我這就開始唸誦縮形之咒。","portrait":{"$m":478}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"....化體移型，皆為珍瓏妙象。吐納乾坤，寶內別有洞天....收！","portrait":{"$m":478}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"....縮型之咒果真有用。好，接著是『魂翔御光法』。氣發乎劍，托承吾體。陰陽交忽，兩元御替....起！","portrait":{"$m":478}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"大夥都沒事吧？在珍瓏鏡玉內感覺如何？","portrait":{"$m":478}},{"speaker":"燕明蓉","speaker_key":"face:8","side":1,"text":"哇！真是有趣極了！玉內別有天地，四壁透明，就如水晶宮一般。只可惜殷大哥放在衣袋內，不然在飛行時朝外看去，想必是更加有趣。","portrait":{"$m":456}},{"speaker":"上官遠","speaker_key":"face:4","side":1,"text":"哈哈，小姑娘就愛新奇刺激，咱們可不是來這裡玩的。","portrait":{"$m":498}},{"speaker":"燕明蓉","speaker_key":"face:8","side":1,"text":"什麼嘛！上官大哥剛才不也在裡面大呼過癮，還說什麼生平不曾遇過有這等有趣之事，現在還敢說人家。哼！","portrait":{"$m":587}},{"speaker":"上官遠","speaker_key":"face:4","side":1,"text":"....哈哈哈，說不過妳，算我不對便是。","portrait":{"$m":500}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"呵呵。這還不算什麼，等咱們真的到了地界，想必到處都能讓你們大開眼界。不過此地岩漿四佈、炙熱逼人，咱們全靠混元寶塔才能保無事，並不適合久留，咱們還是趕快覓路下去為宜。","portrait":{"$m":531}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"南方不遠處有一大坑，看來深不見底，神隱前輩所言之處，應該就是那裡不會錯。不過這火山口雖然如此炎熱，卻也有不少妖魔生息於此，倘若咱們要從洞口下去，恐怕免不了會遇上它們。","portrait":{"$m":530}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"既然咱們不能在此地久留，那便別無他法，只有強闖一途了。","portrait":{"$m":479}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"嗯！不過此地的妖物嗜熱好炎，特性與尋常妖魔大異，大夥可得多留神些。","portrait":{"$m":530}},{"speaker":"上官遠","speaker_key":"face:4","side":1,"text":"管他那麼多，打看看就知道。咱們走吧！","portrait":{"$m":498}}],[{"id":0,"animation":{"$":55},"depth":20000000,"origin":{"camera":[12,8]},"frame":0,"end":0,"mode":"held"}],"b7bbffd8f09dfec90244b8b1a4fbac8e1e5cddfb83412fd0e167d8d13f4b8367","3721522921911247c9d04504f844ba458ebdc18a64294ccfe13722d69c624aea",[{"id":0,"animation":{"$":56},"depth":20000000,"origin":{"camera":[22,12]},"frame":171,"end":171,"mode":"held"}],"第20回合・敵方行動前","第34回合・我方行動前",[{"id":0,"x":25,"y":25,"visible":true,"group":1,"direction":3},{"id":1,"x":24,"y":25,"visible"