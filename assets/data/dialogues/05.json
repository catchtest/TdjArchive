nd":1,"camera":[9,10],"layers":[],"units":{"$":64},"step":34,"base":"overview"},{"line":9}],[{"background":1,"camera":[9,10],"layers":[],"units":{"$":64},"step":35,"base":"overview"},{"line":10}],[{"background":1,"camera":[9,10],"layers":[],"units":{"$":64},"step":36,"base":"overview"},{"line":11}],[{"background":1,"camera":[9,10],"layers":[],"units":{"$":64},"step":37,"base":"overview"},{"line":12}],[{"background":1,"camera":[9,10],"layers":[],"units":{"$":64},"step":38,"base":"overview"},{"line":13}]],"$extra":true},[{"label":"戰鬥勝利：敵方全滅"}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["劍聖","face:11",1,"唉，沒有料到朱慎會避戰而退，這是我的失策。不過....",{"$m":470}],["劍聖","face:11",1,"是誰叫你們來找這蚩尤右角？事關重大，我非問清楚不可。",{"$m":472}],["殷劍平","face:1",1,"是晚輩的主張，還望前輩恕罪。",{"$m":426}],["劍聖","face:11",1,"哼，剛才那老兒乃是名列『鬼道四邪』之一的『邪隱』朱慎，豈是你們這些娃娃對付得了的？可嘆世人無知，儘以為蚩尤雙角是何等神物，其實大謬不然，就算真給你們搶到了手，要是亂用其中妖力，小心連命都給送了。",{"$m":472}],["封寒月","face:2",1,"前輩此言差矣，我們才不是貪圖寶物。這些妖人先前劫奪我們一位朋友護的皇鏢，害他沒辦法回京城交差，之後又遣個妖女謀害我常師伯，咱們的樑子結得可大了。他們要取這右角，我們就偏生要和他搗亂，和那角可沒啥關連。",{"$m":454}],["劍聖","face:11",1,"哈哈哈，小姑娘說話有口無心。也罷，我管不了你們和十方鬼眾有何過節，不過蚩尤雙角關連重大，你們若非有心為此事出力，還是不要涉足其中為宜。",{"$m":470}],["殷劍平","face:1",1,"多謝前輩勸告。想那十方鬼眾必非善類，若晚輩等能助一臂之力，還望前輩不吝差遣。",{"$m":426}],["劍聖","face:11",1,"那便等來日再說了，你們自己保重。後會有期！",{"$m":470}],["封寒月","face:2",1,"什麼嘛！這人看來也沒多大年紀，說起話來卻老氣橫秋的，令人聽了就有氣。",{"$m":454}],["殷劍平","face:1",1,"封姑娘別這麼說。這位前輩修為極高，咱們都是親眼見到的，他要我們不涉入此事，想來也是為了我們好。",{"$m":426}],["封寒月","face:2",1,"哼，若是依他的話，上官大哥的皇鏢也就不用再查了？",{"$m":454}],["殷劍平","face:1",1,"當然要繼續查下去，這是咱們自己的事。只是如今右角也已失落，今後要找到這批妖人的下落，可是件莫大難事。",{"$m":426}],["上官遠","face:4",1,"這以後再提吧，我瞧這山谷中陰氣越來越重，搞不好待會要起霧，咱們還是先出谷再說。",{"$m":446}],["殷劍平","face:1",1,"上官大哥說的是。咱們這就走吧！",{"$m":426}]]},{"next_scene":"battle:6"}]],"$extra":true},"$mediaVersion":"e1682a31b310","$pool":[[{"id":0,"frame":0,"mode":"held"},{"$":1},{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"$":7}],{"id":1,"frame":0,"mode":"held"},{"id":2,"frame":0,"mode":"held"},{"id":3,"frame":0,"mode":"held"},{"id":4,"frame":0,"mode":"held"},{"id":5,"frame