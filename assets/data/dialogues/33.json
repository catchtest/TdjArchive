{"entries":[{"id":"event-1","kind":"opening","title":"戰鬥前","steps":{"$keys":["scene"],"$rows":[[{"background":1,"camera":[30,0],"layers":[],"units":{"$keys":["id","x","y","visible","group","direction"],"$rows":[[0,37,3,true,1,1],[1,36,3,true,1,1],[2,38,3,true,1,1],[3,36,2,true,1,1],[4,38,2,true,1,1],[5,37,2,true,1,1],[6,39,3,true,1,1],[7,39,2,true,1,1],[8,37,1,true,1,1],[9,38,1,true,1,1]]},"step":13,"base":"configured","motion":{"$keys":["id","from","$ms","tick_ms"],"$rows":[[0,[42,3],1800,120],[1,[41,3],1800,120],[2,[43,3],1800,120],[3,[41,2],1800,120],[4,[43,2],1800,120],[5,[42,2],1800,120],[6,[44,3],1800,120],[7,[44,2],1800,120],[8,[42,1],1800,120],[9,[43,1],1800,120]]},"$ms":1800},{"visual_only":true}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":24,"base":"configured"},{"line":0}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":25,"base":"configured"},{"line":1}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":26,"base":"configured"},{"line":2}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":27,"base":"configured"},{"line":3}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":28,"base":"configured"},{"line":4}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":29,"base":"configured"},{"line":5}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":30,"base":"configured"},{"line":6}],[{"background":1,"camera":[30,0],"layers":[],"units":{"$":0},"step":31,"base":"configured"},{"line":7}]],"$extra":true},"conditions":[{"label":"戰鬥前的開場劇情"}],"lines":{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["封寒月","face:2",1,"嘩，好漂亮的地方！這裡是....",{"$m":361}],["上官遠","face:4",1,"這兒不是玄海之底了嗎？怎麼四周還這麼亮？",{"$m":380}],["紫楓","face:3",1,"這裡本是環繞玄海周圍的巨大冰壁，後來在一次地震中崩毀，冰柱斷折之後的平台碰巧成為通往玄海之底的捷徑。由於地界靈氣多年來沈積於此，冰壁上盡皆凝有一層靈結晶霜，這靈晶自體會發出微光，正好把此地映得十分明亮。",{"$m":435}],["殷劍平","face:1",1,"天地萬物之奇，果是出人意料之外。我本擔心越往下走會越暗，豈知到頭來全然不成問題。",{"$m":358}],["上官遠","face:4",1,"那不豈好，咱們快趁這機會通過這裡，否則此地呈狹橋之勢，要是被敵人兩側夾擊，那可大大不妙。",{"$m":380}],["真胤","face:6",1,"來是不用急了，前方冰面上已有大批妖魔蠢動，想來是被蚩尤復生所凝聚的妖氣所吸引來的。想要順利通過此地，恐怕一場大仗在所難免。",{"$m":450}],["鮮于超","face:5",1,"任他千軍萬馬擋路，咱們也得設法衝殺過去。上官老兄，還是我們兩個打頭陣吧！",{"$m":427}],["上官遠","face:4",1,"哈哈哈，那成什麼問題！",{"$m":382}]]}},{"id":"event-2","kind":"victory","title":"戰鬥勝利","steps":{"$keys":["scene"],"$rows":[[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"step":6,"base":"overview","$ms":600},{"visual_only":true}],[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"tint":[0,0,0,16],"step":7,"base":"overview","tint_animation":[[0,0,0,16,40],[0,0,0,16,40],[16,0,0,16,40],[16,0,0,16,40],[48,0,0,16,40],[48,0,0,16,40],[64,0,0,16,40],[64,0,0,16,40],[96,0,0,16,40],[96,0,0,16,40],[112,0,0,16,40],[112,0,0,16,40],[144,0,0,16,40],[144,0,0,16,40],[160,0,0,16,40],[160,0,0,16,40],[192,0,0,16,40]]},{"visual_only":true}],[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"tint":[192,0,0,16],"step":10,"base":"overview","$ms":1000},{"visual_only":true}],[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"tint":[192,0,0,16],"step":12,"base":"overview","$ms":1000},{"visual_only":true}],[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"tint":[192,0,0,16],"step":14,"base":"overview","$ms":1000},{"visual_only":true}],[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"tint":[192,0,0,16],"step":16,"base":"overview","$ms":1000},{"visual_only":true}],[{"background":1,"camera":null,"focus":[36,3],"layers":[],"units":{"$":11},"tint":[192,0,0,16],"step":17,"base":"overview","tint_animation":[[192,0,0,16,40],[160,0,0,16,40],[160,0,0,16,40],[144,0,0,16,40],[144,0,0,16,40],[112,0,0,16,40],[112,0,0,16,40],[96,0,0,16,40],[96,0,0,16,40],[64,0,0,16,40],[64,0,0,16,40],[48,0,0,16,40],[48,0,0,16,40],[16,0,0,16,40],[16,0,0,16,40],[0,0,0,16,40],[0,0,0,16,40]]},{"visual_only":true}],[{"background":1,"camera":null,"foc