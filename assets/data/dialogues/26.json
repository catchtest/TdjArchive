5,"base":"configured"},{"line":44}],[{"background":1,"camera":[25,16],"layers":{"$":46},"units":{"$":48},"step":157,"base":"configured"},{"line":45}],[{"background":1,"camera":[0,16],"layers":[{"id":2,"frame":23,"end":40,"mode":"once"},{"$":33},{"$":47}],"units":{"$":48},"step":159,"base":"configured"},{"visual_only":true}],[{"background":1,"camera":[25,16],"layers":{"$":59},"units":{"$":48},"step":162,"base":"configured"},{"line":46}],[{"background":1,"camera":[25,16],"layers":{"$":59},"units":{"$":48},"step":163,"base":"configured"},{"line":47}],[{"background":1,"camera":[25,16],"layers":{"$":59},"units":{"$":48},"step":164,"base":"configured"},{"line":48}]],"$extra":true},[{"label":"戰鬥前的開場劇情"}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["燕明蓉","face:8",1,"哇，好巨大的岩橋！",{"$m":469}],["封寒月","face:2",1,"自從過了天鏡法陣之後，所見的景緻與之前又自不同。等等，莫非眼前這深不見底的黑霧之海，就是那分隔萬物生死兩界的幻海？",{"$m":385}],["紫楓","face:3",1,"是的，此地就是幽都四海之一的幻海，也是四海之中最為廣大的，越過那層濃霧就是生人所不可褻近的死界。佇立在幻海正中的是支撐地界的支柱寰神九山，也就是幽都諸民所居之處，三荒冥原、七仞炎窟等各地則圍繞著它。",{"$m":428}],["鮮于超","face:5",1,"原來如此。",{"$m":425}],["紫楓","face:3",1,"這岩橋是通往三荒冥原唯一之道，根據古籍的記載，萬炎源頭的熔岩之海赤煉淵就位在那裡。",{"$m":428}],["封寒月","face:2",1,"那我們快走吧！別讓前輩在赤煉淵等得不耐煩了。",{"$m":385}],["殷劍平","face:1",1,"封姑娘，等等....",{"$m":376}],["封寒月","face:2",1,"....唔！",{"$m":387}],["封寒月","face:2",1,"....好痛！啊....頭....頭好痛.....",{"$m":486}],["殷劍平","face:1",1,"封姑娘！妳怎麼了？",{"$m":381}],["封寒月","face:2",1,"啊..啊....不要....有什麼..有什麼像是要..鑽進我的頭裡面....啊....",{"$m":486}],["殷劍平","face:1",1,"封姑娘，妳不要緊吧！",{"$m":381}],["紫楓","face:3",1,"殷公子小心，封姑娘的身上繚繞著很強的妖氣！",{"$m":430}],["殷劍平","face:1",1,"....什麼？！",{"$m":382}],["封寒月","face:2",1,"....師父？是您嗎？",{"$m":412}],["韓千秀","face:7",1,"這是怎麼回事？靈山前輩應該已經仙逝了啊！",{"$m":448}],["上官遠","face:4",1,"莫非是靈山前輩的鬼魂？",{"$m":424}],["真胤","face:6",1,"不，這是邪派的化形幻法，和以前韓無砂化身成方云的幻術如出一轍，貧僧以為這八成是四邪之一偽裝的。",{"$m":440}],["靈山老人","face:37",0,"乖孩兒，師父來接妳了。來，過來師父身邊，讓我好好瞧瞧妳....",{"$m":487}],["封寒月","face:2",1,"師父！我..我這就過去！",{"$m":412}],["殷劍平","face:1",1,"封姑娘！不要去！那不是靈山前輩！",{"$m":382}],["封寒月","face:2",1,"....師父，我好想您！",{"$m":412}],["殷劍平","face:1",1,"封姑娘...月兒！妳醒醒啊！",{"$m":382}],["靈山老人","face:37",0,"乖孩兒，來的好....哈哈哈哈哈哈！",{"$m":487}],["殷劍平","face:1",1,"朱慎，原來是你！你想對月兒怎樣？",{"$m":382}],["朱慎","face:35",0,"呵呵，這姑娘對我們另有用處，我先借她一用了，來日再行奉還。哈哈哈哈！",{"$m":418}],["殷劍平","face:1",1,"等等！",{"$m":382}],["殷劍平","face:1",1,"月兒！月兒！可惡...",{"$m":463}],["鮮于超","face:5",1,"看來對方在此早有佈置，劫走封姑娘乃是預謀。可是他們為何要劫走封姑娘？",{"$m":432}],["劍邪","face:32",0,"這個就讓本座來解釋吧。",{"$m":431}],["殷劍平","face:1",1,"....爹！是..是您？....把月兒還我！",{"$m":377}],["劍邪","face:32",0,"平兒，看來你對那小姑娘頗有情意啊。你放心，我只是借她一用，這個媳婦兒你挑得不錯，我會盡力保她寸髮無傷的。",{"$m":431}],["殷劍平","face:1",1,"我....我不相信！您到底想對她怎樣？！",{"$m":377}],["劍邪","face:32",0,"既然你這麼不放心，本座就告訴你原因好了。那姑娘的身上流有妖魔的血脈，具有吸引邪靈妖力憑身之能。你們毀破魂晶之時，放出的蚩尤天魂並非回到天地之間，而是直接憑附在她身上，由此可知她體質非常接近『魔』",{"$m":431}],["殷劍平","face:1",1,"....！！！",{"$m":382}],["劍邪","face:32",0,"本座本也不相信此事，但剛才不過命朱慎施展『邪魂共應』的咒法，她身上的蚩尤天魂即刻有了反應，你也瞧見她忽然頭痛欲裂、幾至暈厥，她身上的邪魂共應如此之強，應是蚩尤天魂不會錯。",{"$m":431}],["殷劍平","face:1",1,"就算真是如此，那又與她何干？",{"$m":377}],["劍邪","face:32",0,"要讓蚩尤真正復活，天地雙魂、望朔兩角缺一不可，既然天魂在這姑娘體內，那就得將它給逼出來，由於分魂之法極為耗時費力，需得另覓合適場合，所以先向你借她一用。",{"$m":431}],["紫楓","face:3",1,"劍邪，你該知道分魂之法極是艱險，倘若一有失閃，勢必危及封姑娘的性命！",{"$m":433}],["劍邪","face:32",0,"嘿嘿，為成大事，犧牲本就在所難免。這個姑娘根骨雖佳，但若她熬不過這一關那也是她注定與平兒無緣，無需難過。",{"$m":431}],["殷劍平","face:1",1,"遣四邪齊祀之輩到處設下陰毒的法陣，用無辜百姓和月兒的性命來換取蚩尤的復活，您也知道魔神蚩尤復活之後今世頓成焦土煉獄，但您一點也不在乎！人命在您的眼中算什麼？我..我不認您這樣的父親！",{"$m":463}],["劍邪","face:32",0,".....復活蚩尤是本座策畫多年的大計，膽敢妨礙的全都得死。平兒，本座是看在你的份上才讓你們活到現在，不過就到此為止了。我這爹你認也好，不認也好，但別以為本座捨不得殺你，你死了之後一樣會在靈闕池轉生為魔人，本座只是不願父子相殘，你明白麼？",{"$m":431}],["殷劍平","face:1",1,"若您再這樣一意孤行下去，孩兒別無他途，也只有冒忤逆不孝之名，在戰場上以死相諫罷了。",{"$m":463}],["劍邪","face:32",0,"哼，以死相諫....這也由得你。不過此刻本座無暇和你糾纏，先試試你們過不過得了這橋吧！",{"$m":431}],["劍邪","face:32",0,"平兒，有機會咱們下回見了。",{"$m":431}],["殷劍平","face:1",1,"爹，等等！....",{"$m":382}],["紫楓","face:3",1,"殷公子，現在擔心封姑娘也沒用，還是靜心沈氣，先過了眼前的難關再說。",{"$m":428}],["殷劍平","face:1",0,"嗯，我明白....",{"$m":381}],["上官遠","face:4",1,"殷老弟，打起精神來！等宰了這些兔崽子之後，咱們再一起去救封姑娘！",{"$m":401}]]},{}],["event-5","turn",{"$":60},[{"line":0,"scene":{"background":1,"camera":null,"focus":[31,