":14}],[{"$r":[3,1,[10,32],{"$":0},{"$":19},{"id":3},45,"configured"]},{"line":15}],[{"$r":[3,1,[10,32],{"$":0},{"$":19},{"id":3},46,"configured"]},{"line":16}],[{"$r":[3,1,[10,10],{"$":0},{"$":19},{"id":3},48,"configured"]},{"line":17}],[{"background":1,"camera":[10,10],"layers":{"$":0},"units":{"$":36},"music":{"id":3},"step":56,"base":"configured","$ms":240},{"visual_only":true}]],"$extra":true},[{"label":"戰鬥前的開場劇情"}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["上官遠","face:4",1,"嘖，好重的霉臭味。不過我倒沒想到井壁上真的有暗道....",{"$m":52}],["鮮于超","face:5",1,"大戶人家為了保命防災，建有這種逃生用的小密道也是常有的事。只是這地窖朽廢成這樣，看來是很久沒用了。",{"$m":99}],["紫楓","face:3",1,"對方專挑這種不會引人注意的地方作法，也算得上是高明。",{"$m":106}],["封寒月","face:2",1,"哼，我倒要看看到底是什麼傢伙在這裡弄鬼。",{"$m":31}],["殷劍平","face:1",1,"封姑娘，等等！",{"$m":11}],["紫楓","face:3",1,"對方並非庸手，大夥還是不要單獨行動為宜。咱們也下去吧！",{"$m":106}],["上官遠","face:4",1,"嗯！",{"$m":52}],["朱慎","face:35",1,"嘿嘿，我還道是誰會找到這裡來，原來又是你們。",{"$m":86}],["上官遠","face:4",1,"鬼老頭，上次的帳還沒跟你算，有種的這回就別逃！",{"$m":52}],["朱慎","face:35",1,"嘿嘿嘿，老夫佈下這個『三陰冥幻陣』，本就是不想讓任何人活著離開。不過既然讓你們查到了這裡，當然就先送你們歸天了。",{"$m":86}],["紫楓","face:3",1,"邪隱朱慎，小女子也曾聽過閣下的大名。聽說你陰狠狡詐，行事必經深思熟慮，依此看來，你大費周章設下此陣，不會只是為了困住我們吧？",{"$m":111}],["朱慎","face:35",1,"這位姑娘果然是明眼人，就告訴你們實情也無妨。老夫先幾日便已發現你們來此，恰好主人查到蚩尤骨骸就在附近，命冥皇鄲陰前去發掘，老夫料到你們必會前來阻撓，因此結陣將你們困在此地，準備稍後再慢慢料理。",{"$m":86}],["紫楓","face:3",1,"蚩尤骨骸就埋在附近？....莫非是在幻幽谷？",{"$m":111}],["朱慎","face:35",1,"一猜就中，姑娘當真是有天人之慧，佩服佩服。",{"$m":86}],["上官遠","face:4",1,"原來如此，這鬼老頭只是要拖住我們而已。需得趕快解決了他，再去阻止鄲陰發掘蚩尤遺骸。",{"$m":57}],["封寒月","face:2",1,"殷大哥，這冥幻陣具阻隔之能，我們無法入陣對付那鬼老頭，不過他也一樣不能對咱們動手。等解決了他召出來的妖魔之後，咱們再設法破冥幻陣。",{"$m":31}],["殷劍平","face:1",1,"嗯，就這麼辦！",{"$m":12}],["朱慎","face:35",1,"嘿嘿，等你們解決老夫這些小廝，老夫再出來陪你們玩玩。",{"$m":86}]]},{}],["event-6-path-1","kill","敵方單位被擊倒（第一批敵軍剩6人以下）",{"$keys":["scene"],"$rows":[[{"$r":[19,1,[10,10],{"$":0},{"$":36},8,"overview"]},{"line":0}],[{"$r":[25,1,[15,12],{"$":0},{"$":36},9,"overview",{"$":39}]},{"visual_only":true}],[{"$r":[11,1,[15,12],{"$":0},{"$":40},[112,112,112,16],11,"overview",{"$":44}]},{"visual_only":true}