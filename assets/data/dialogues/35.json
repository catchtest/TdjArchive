1800,120],[3,[18,83],1800,120],[4,[20,83],1800,120],[5,[22,83],1800,120],[6,[17,84],1800,120],[7,[19,84],1800,120],[8,[21,84],1800,120],[9,[23,84],1800,120],[0,[20,81],1800,120]]},1800]},{"visual_only":true}],[{"$r":[15,1,[15,76],[],{"$":115},49,"overview",2000]},{"visual_only":true}],[{"$r":[12,1,[15,76],[],{"$":115},[0,0,0,16],50,"overview",[[0,0,0,16,40],[0,0,0,14,40],[0,0,0,12,40],[0,0,0,10,40],[0,0,0,8,40],[0,0,0,6,40],[0,0,0,4,40],[0,0,0,2,40],[0,0,0,0,40]]]},{"visual_only":true}],[{"background":1,"camera":[15,76],"layers":[],"units":{"$":115},"tint":[0,0,0,0],"step":53,"base":"overview","$ms":240},{"visual_only":true}]],"$extra":true},[{"label":"兩佰惡魔被擊倒"},{"label":"兩佰小鬼被擊倒"},{"label":"戰鬥勝利：敵方全滅"}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["兩佰小鬼","face:44",0,"啊，不愧....不愧是主角級的人物，我們果然是只有兩佰塊工錢的命....",{"$m":284}],["兩佰惡魔","face:43",1,"不過我們會再回來的，只要這種遊戲存在的一天....我們的怨恨是不會消解的....好好記住吧....",{"$m":285}],["鮮于超","face:5",1,"雖然還是搞不懂這是怎麼一回事，但我們好像又贏了。",{"$m":99}],["真胤","face:6",1,"好奇怪，我覺得這一戰倒像是在考驗我們的戰力一般。",{"$m":124}],["紫楓","face:3",1,"嗯，說不定是那個編導出的餿主意，難怪我收到一筆不明的演出費...回頭再找他算帳便是。",{"$m":111}],["不淨散人","face:10",1,"嗄？什麼編導？演出費？",{"$m":119}],["紫楓","face:3",1,"啊，沒..沒什麼。總而言之，大家辛苦了，待會我請大家去夏侯兄打工的啤酒屋喝個痛快，聽說夏侯兄可是那兒的紅牌，大家排隊預約的唷！到時要吃什麼大家盡量點.....夏侯兄會打個折吧？",{"$m":107}],["夏侯儀","face:9",1,"那還有什麼問題，只是我到時可沒空陪你們......",{"$m":129}],["上官遠","face:4",1,"喝酒？啊哈，沒問題，沒問題！我可絕對要堅持〝尚青〞的唷！",{"$m":54}],["燕明蓉","face:8",1,"紫楓姐真的要請客？那我要大塊沙朗哦！",{"$m":181}],["韓千秀","face:7",1,"唉，人家還在減肥....最近真是沒有口福....",{"$m":140}],["殷劍平","face:1",1,"....？？？？？",{"$m":18}],["封寒月","face:2",1,"殷大哥，你杵在那兒幹嘛？走了啦！發什麼呆呀！",{"$m":35}]]}],["event-0","defeat",{"$":116},{"$keys":["line","scene"],"$rows":[[0,{"$r":[6,1,null,[20,78],[],{"$":117},2,"overview"]}],[1,{"$r":[6,1,null,[20,78],[],{"$":117},3,"overview"]}],[2,{"$r":[6,1,null,[20,78],[],{"$":117},4,"overview"]}],[3,{"$r":[6,1,null,[20,78],[],{"$":117},5,"overview"]}],[4,{"$r":[6,1,null,[20,78],[],{"$":117},6,"overview"]}],[5,{"$r":[6,1,null,[20,78],[],{"$":117},7,"overview"]}],[6,{"$r":[6,1,null,[20,78],[],{"$":117},8,"overview"]}]]},[{"label":{"$":116}},{"label":"戰鬥敗北：殷劍平被擊倒"}],{"$keys":["speaker","speaker_key","side","text"],"$rows":[["殷劍平","face:1",1,"好..好強！沒想到天地間還有這麼強的妖魔....",{"portrait":{"$m":13}}],["旁白",null,-1,"嘿嘿嘿，總算打敗你們啦。依照先前的約定，我們終於可以升格為正式主角，演員費也會跟著水漲船高，不再只是拿兩佰塊了。",{}],["旁白",null,-1,"可是編導那邊好像....還沒有配給我們的CASE耶。",{}],["旁白",null,-1,"那有什麼關係？我們就寫個腳本自編自演，例如『天地劫前傳：兩佰大反擊』之類的不就好了？",{}],["旁白",null,-1,"這種題材恐怕沒市場吧....",{}],["旁白",null,-1,"今後是我們兩佰塊的時代，由不得他們不看！",{}],["殷劍平","face:1",1,"啊，還是聽不懂他們在說什麼....",{"portrait":{"$m":13}}]],"$extra":true}]]},"scene_media":{"movement":{"1":{"$r":[7,"b930a270e07ee291ba798b44ed2a2d1175920240156cf3c2284a93800b6ae021",{"walk":[0,4],"start":[16,11],"end":[60,10]},{"moving":[[12,0,42,48],[9,0,40,48],[0,0,44,48],[3,0,40,48]]}]},"2":{"$r":[7,"c8e958b250f55d47ded2021059d79a095bf15801ccf62efd7f4a04294e22ca47",{"walk":[0,8]},{"moving":[[0,0,40,41],[7,0,37,41],[6,0,32,41],[2,0,37,41]]}]},"3":{"$r":[7,"1cdb68fa32d7c9695d7f37da7b1cc6ac759e5f52103674575ce38d59107af14b",{"walk":[0,10]},{"moving":[[1,1,33,43],[2,0,32,44],[0,2,33,43],[2,0,32,44]]}]},"4":{"$r":[7,"a85680783cb357dba8665b051405a85b9d82ebc9cb4e448e3effae8ebe2bb676",{"walk":[0,4]},{"moving":[[25,0,44,73],[8,12,80,51],[20,6,42,57],[0,12,80,51]]}]},"5":{"$r":[7,"6799fc59856fdb77c8738e4b316fee5899ff37bd13c182bf00fe24c157f147ad",{"walk":[0,8]},{"moving":[[0,3,79,52],[16,0,42,55],[4,2,79,53],[22,0,42,55]]}]},"6":{"$r":[7,"5d92a001e63de489a0d7a26434d094cbbe58c09d1bd6024558b6b70cd161abd6",{"walk":[0,4]},{"moving":[[0,0,58,45],[0,1,56,43],[10,0,77,45],[16,1,56,43]]}]},"7":{"$r":[7,"6a40e3608bbe8be5ce2e1ab20831af991cd2d631a56f4f73cdf49363423e475d",{"walk":[0,4]},{"moving":[[1,0,33,42],[4,1,33,40],[2,0,37,42],[0,0,33,40]]}]},"8":{"$r":[7,"90a309594168d17340e0374a8c2c9cd8f0bc5104176dda8366328c7f5bf8abde",{"walk":[0,4]},{"moving":[[0,0,31,41],[1,1,28,39],[0,0,31,41],[2,1,28,39]]}]},"9":{"$r":[7,"65905bb9bfefb2cf803089300cf44ef0cbcad698d87e8cc8389c28fc48c6e718"