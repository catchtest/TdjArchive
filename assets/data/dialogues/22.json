":75},{"$":76},{"$":77},{"$":78},{"$":79},{"$":80},{"$":81},{"$":82},{"$":83},{"$":84},{"$":85},{"$":86},{"$":87},{"$":88},{"$":89},{"$":90},{"$":91},{"$":92},{"$":93},{"$":94},{"$":95},{"$":96},{"$":97},{"$":98},{"$":99},{"$":100},{"$":101},{"$":102},{"$":103},{"$":104},{"$":105},{"$":106},{"$":107},{"$":108},{"$":112},{"$":109}],{"$r":[0,23,{"$r":[2,2,[9,6],{"$":0},{"$":160},{"$":115},null,81,"overview"]}]},{"$r":[0,24,{"$r":[2,2,[9,6],{"$":0},{"$":160},{"$":115},null,82,"overview"]}]},{"$r":[0,25,{"$r":[2,2,[9,6],{"$":0},{"$":160},{"$":115},null,83,"overview"]}]},{"$r":[0,26,{"$r":[2,2,[9,6],{"$":0},{"$":157},{"$":115},null,85,"overview"]}]},{"$r":[0,27,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,87,"overview"]}]},[{"$":139},{"$":120},{"$":140},{"$":141},{"$":158},{"$":143},{"$":144},{"$":145},{"$":146},{"$":147},{"$":75},{"$":76},{"$":77},{"$":78},{"$":79},{"$":80},{"$":81},{"$":82},{"$":83},{"$":84},{"$":85},{"$":86},{"$":87},{"$":88},{"$":89},{"$":90},{"$":91},{"$":92},{"$":93},{"$":94},{"$":95},{"$":96},{"$":97},{"$":98},{"$":99},{"$":100},{"$":101},{"$":102},{"$":103},{"$":104},{"$":105},{"$":106},{"$":107},{"$":108},{"$":112},{"$":109}],{"$r":[0,28,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,88,"overview"]}]},{"$r":[0,29,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,89,"overview"]}]},{"$r":[0,30,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,90,"overview"]}]},{"$r":[0,31,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,91,"overview"]}]},{"$r":[0,32,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,92,"overview"]}]},{"$r":[0,33,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,93,"overview"]}]},{"$r":[0,34,{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,94,"overview"]}]},{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,97,"overview"]},{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,98,"overview"]},{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,99,"overview"]},{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,100,"overview"]},{"$r":[2,2,[9,6],{"$":0},{"$":166},{"$":115},null,101,"overview"]},{"label":"韓無砂被擊倒"},{"label":"戰鬥勝利：韓無砂被擊倒"},{"$r":[1,"韓無砂","face:34",1,"我不相信....我三千年的修行，竟然....竟然敵不過一群凡人....盟主，救我....",{"$m":158}]},{"$r":[1,"紫楓","face:3",1,"嗯，韓無砂原來是條修練三千年的蟒精啊。她本是可以修成正果的，只可惜墮入了魔道，以至今日落得這般下場，實在也有點可憐呢。",{"$m":106}]},{"$r":[1,"上官遠","face:4",1,"非也非也，韓無砂的兇殘獰惡乃是蛇類天性，這是修成正果也改不了的。今日她把我們逼到這步田地，若非封姑娘短劍的一擊，只怕如今在天上可哀可憐的會是咱們呢。所以這婆娘死得好，一點都不可憐！",{"$m":52}]},{"$r":[1,"紫楓","face:3",1,"上官兄這麼說也沒錯。三魄鬼眼的確威力無比，多虧了那柄短劍，咱們才能僥倖獲勝。",{"$m":107}]},{"$r":[1,"殷劍平","face:1",1,"嗯，說是那柄短劍救了我們也不為過。封姑娘，那柄朱刃短劍怎樣了？",{"$m":11}]},{"$r":[1,"封寒月","face:2",1,"....已經毀了。劍身的靈氣四散，現在這柄劍就和凡鐵沒有兩樣....",{"$m":75}]},{"$r":[1,"殷劍平","face:1",1,"啊！怎麼會這樣？！",{"$m":17}]},{"$r":[1,"封寒月","face:2",1,"說也奇怪，在我將氣勁往劍身集聚之時，這劍就像知道我的心思一般，筆直的就往她身上刺了過去，劍上的氣勁一鼓作氣擊破了三魄鬼眼，然後就四散消失了。",{"$m":76}]},{"$r":[1,"殷劍平","face:1",1,"這柄劍外表並不顯眼，沒想到在妳手中竟然如此神異，想是它與妳靈蘊相通之故。",{"$m":11}]},{"$r":[1,"封寒月","face:2",1,"嗯。我想這柄劍被師父珍藏在藏寶室之中必非偶然，說不定它和我有很深的關係。自從拿到這柄短劍後，我就一直覺得對它很是熟悉，就像是沒見過面的親人一般，覺得這劍會在冥冥中保護我...",{"$m":76}]},{"$r":[1,"紫楓","face:3",1,"....原來如此。封姑娘，如今思來，或許那柄劍真是妳母親的遺物也說不定。",{"$m":107}]},{"$r":[1,"封寒月","face:2",1,"....是啊。雖然已經沒有人能夠告訴我真相，但我會一直把這柄劍帶在身邊。就當作是紀念今日之事好了。",{"$m":76}]},{"$r":[1,"紫楓","face:3",1,"對了，雖然韓無砂已伏誅，她設下的邪陣仍在磐天嶺上，咱們快去把它封除，以免造成更大危害。",{"$m":106}]},{"$r":[1,"殷劍平","face:1",1,"啊！顧著說話，都忘了這件事情了。事不宜遲，咱們這就趕回磐天嶺吧！",{"$m":11}]},{"$r":[1,"封寒月","face:2",1,"嗯！",{"$m":31}]},{"$r":[1,"殷劍平","face:1",1,"紫楓姑娘，一切進行得如何？",{"$m":11}]},{"$r":[1,"紫楓","face:3",0,"嗯，幸而有真胤大師之助，我已將韓無砂設下的『死腐屍障』毀撤淨盡，磐天嶺上的妖氣已除，一切應該已無大礙。封姑娘，妳可以叫下山避難的弟子門人回來了。",{"$m":107}]},{"$r":[1,"封寒月","face:2",0,"紫楓姐姐，這幾天真是有勞妳了。若沒有妳的話，只怕師父留下來的偌大基業都會在韓無砂的毒計下毀棄殆盡，那時....我死了也沒臉去見師父....",{"$m":76}]},{"$r":[1,"紫楓","face:3",0,"呵呵，這不過是舉手之勞，封姑娘不用如此客氣。不過由韓無砂夜襲一事，卻有諸多可疑之處，令我十分掛慮。",{"$m":107}]},{"$r":[1,"殷劍平","face:1",1,"紫楓姑娘，韓無砂已然伏誅，不知尚有何不妥之處？",{"$m":11}]},{"$r":[1,"紫楓","face:3",0,"這回韓無砂寧可拼到元神潰滅也不退走，實是大非尋常。聽韓無砂最後的言語，顯然劍邪這次遣她來對付我們是志在必得，而且只許成功不許失敗，想是她知道若敗走回去也是死路一條，所以乾脆和我們拼個死活。",{"$m":111}]},{"$r":[1,"上官遠","face:4",1,"邪派之徒行事乖張、倒行逆施乃是常事，這倒不足為奇。",{"$m":52}]},{"$r":[1,"紫楓","face:3",0,"但我以為此事並非如此簡單。劍邪忽然謀我甚急，必定是因為他正在圖謀什麼極為要緊的大舉，深恐我們壞了他的好事，所以不論如何也要先將我們一舉擒殺。而他圖謀的大事不會有別的，恐怕是......",{"$m":111}]},{"$r":[1,"殷劍平","face:1",1,"莫非是....復活蚩尤？！",{"$m":18}]},{"$r":[1,"紫楓","face:3",0,"只怕正如殷少俠所料。凶星臨空，入主天宮，這是數十乃至數百年才有一次的機會，劍邪不願錯失此機，是以先下手為強，這也是在意料之中。",{"$m":111}]},{"$r":[1,"封寒月","face:2",0,"既是如此，咱們也非得加快腳步，趕在他們前面先找到神劍才行。",{"$m":33}]},{"$r":[1,"紫楓","face:3",0,"正是。武....嗯....那個人言道神劍封在地界的赤煉淵，咱們要找到神劍，非得下一趟幽冥地界不可。殷少俠，此行禍福難料，能否生還人間尚在未知，在啟程之前，我希望你自己再好好想想。",{"$m":106}]},{"$r":[1,"殷劍平","face:1",1,"紫楓姑娘，這我心中早有覺悟。爹已經變成那個樣子，我生求死諫都已無用，唯有取得神劍方能剋制他的圖謀。不然的話，倘若爹真的讓蚩尤復生，那時人間成了魔窟煉獄，我也不可能獨活。",{"$m":11}]},{"$r":[1,"紫楓","face:3",0,"你能明白這點，那是再好不過了。我身負引路之責，自會和你同赴地界，其餘諸位就尊聽隨便，不願同去者現在便可明言，此後分道揚鑣，互祈來日再見之時，亦是感銘在心。不知諸位以為如何？",{"$m":106}]},{"$r":[1,"封寒月","face:2",0,"殷大哥，不管你上哪裡，我自都與你同去。",{"$m":31}]},{"$r":[1,"上官遠","face:4",1,"紫楓姑娘，妳說這話太不夠意思，打架這等好事怎可少了我上官遠？",{"$m":52}]},{"$r":[1,"鮮于超","face:5",1,"呵呵呵，上官老兄都這麼說了，此行自是少不了俺這一份。",{"$m":99}]},{"$r":[1,"真胤","face:6",1,"當初貧僧是不請自來，如今自然也是奉陪到底。",{"$m":123}]},{"$r":[1,"韓千秀","face:7",1,"殷大哥，阻止劍邪復活蚩尤並非你一人之事，只要刀輪還能派上用場，我願繼續盡我這一份力。",{"$m":136}]},{"$r":[1,"燕明蓉","face:8",1,"只要能為師父報仇，我當然也去！",{"$m":177}]},{"$r":[1,"殷劍平","face:1",1,"大家....大家都要一起去？",{"$m":30}]},{"$r":[1,"紫楓","face:3",0,"看來好像是如此。這樣一來，想必路上就不會寂寞了。",{"$m":107}]},{"$r":[1,"封寒月","face:2",1,"事不宜遲，咱們這就儘速動身吧。若依常伯伯之言，扶桑古木底下藏有往地界的入口，那麼咱們得往川中一趟....",{"$m":31}]},{"$r":[1,"紫楓","face:3",0,"倒不用這麼急。我想地界入口應該不只這一處，咱們先到各地查訪，或許還能問到其他消息。要緊的是，咱們入地界之後未必能再回來，在啟程之前需得將諸般所需武具雜物採買妥當。至於查訪一事，正可乘此機會一起進行。",{"$m":107}]},{"$r":[1,"殷劍平","face:1",1,"啊！我一時倒沒想到這麼多。果然還是紫楓姑娘慮深見廣，咱們就這麼辦吧。",{"$m":30}]}],"$fields":[["line","scene"],["speaker","speaker_key","side","text","portrait"],["background","camera","layers","units","effects","music","step","base"],["id","x","y","visible","group","direction"],["id","visible","group"],["id","visible"],["background","camera","layers","units","music","step","base"],["background","camera","focus","layers","units","step","base"],["background","camera","layers","units","music","step","base","$ms"],["animation","phases","gallery_bounds"],["$w","$h","offset","frames","pages"],["background","camera","focus","layers","units","tint","step","base"],["id","visible","group","x","y","direction"],["visual_only","scene"],["background","camera","layers","units","music","step","base","motion","$ms"],["background","camera","layers","units","effects","tint","music","step","base","tint_animation"],["background","camera","layers","units","music","step","base","pan"],["background","camera","focus","layers","units","tint","step","base","tint_animation"],["id","animation","depth","origin","frame","end","mode"]]}