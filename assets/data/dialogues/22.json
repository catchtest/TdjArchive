e","scene"],"$rows":[[0,{"$r":[7,1,null,[25,20],{"$":0},{"$":63},8,"overview"]}],[1,{"$r":[7,1,null,[25,20],{"$":0},{"$":63},9,"overview"]}],[2,{"$r":[7,1,null,[25,20],{"$":0},{"$":63},10,"overview"]}],[3,{"$r":[7,1,null,[25,20],{"$":0},{"$":63},11,"overview"]}],[4,{"$r":[7,1,null,[25,20],{"$":0},{"$":63},12,"overview"]}],[5,{"$r":[7,1,null,[25,20],{"$":0},{"$":63},13,"overview"]}]]}}],["event-4","attack",{"$":73},[{"label":{"$":73}}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["韓無砂","face:34",1,"天真的傻姑娘，妳以為憑那柄短劍就能....",{"$m":71}],["韓無砂","face:34",1,"三魄鬼眼！我的三魄鬼眼竟然....",{"$m":77}],["燕明蓉","face:8",1,"太好了！封姐姐！",{"$m":177}],["紫楓","face:3",1,"這柄短劍果然是件不出世的神兵，不過毀了三魄鬼眼之後，它的靈氣也盡數消散了。我們得到這柄神兵，其時之巧，想必也是上天的旨意吧。",{"$m":107}],["韓無砂","face:34",1,"什麼上天的旨意！少笑死人了！就算沒有三魄鬼眼，我一樣能殺盡你們這些下眾！都給我死吧！",{"$m":73}],["真胤","face:6",1,"好個妖孽，如今妳的護身禁制已失，居然還想狂言逞兇！",{"$m":122}],["上官遠","face:4",1,"這婆娘已經窮途末路，咱們何必和她囉唆，痛痛快快的送她歸西便是。",{"$m":52}],["殷劍平","face:1",1,"話雖如此，只怕她被逼到窮地之時會拼死反噬，大家還是小心為上！",{"$m":12}],["封寒月","face:2",1,"知道了！",{"$m":35}]]},{"steps":{"$keys":["scene"],"$rows":[[{"$r":[7,1,null,[20,6],{"$":0},{"$":63},10,"overview"]},{"line":0}],[{"$r":[17,1,null,[20,6],{"$":0},{"$":63},[0,0,0,16],11,"overview",[[0,0,0,16,40],[16,16,16,16,40],[48,48,48,16,40],[80,80,80,16,40],[112,112,112,16,40],[144,144,144,16,40],[176,176,176,16,40],[208,208,208,16,40],[240,240,240,16,40]]]},{"visual_only":true}],[{"$r":[17,1,null,[20,6],{"$":0},{"$":63},[240,240,240,16],14,"overview",[[240,240,240,16,40],[208,208,208,16,40],[176,176,176,16,40],[144,144,144,16,40],[112,112,112,16,40],[80,80,80,16,40],[48,48,48,16,40],[16,16,16,16,40],[0,0,0,16,40]]]},{"visual_only":true}],[{"background":1,"camera":null,"focus":[20,6],"layers":{"$":0},"units":{"$":63},"tint":[0,0,0,16],"step":15,"base":"overview","$ms":1000},{"visual_only":true}],[{"$r":[11,1,null,[20,6],{"$":0},{"$":63},[0,0,0,16],16,"overview"]},{"line":1}],[{"$r":[11,1,null,[20,6],{"$":0},{"$":63},[0,0,0,16],17,"overview"]},{"line":2}],[{"$r":[