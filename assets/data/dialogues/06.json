e":20}],[{"background":1,"camera":[4,4],"layers":[],"units":{"$":67},"step":39,"base":"overview"},{"line":21}],[{"background":1,"camera":[4,4],"layers":[],"units":{"$":67},"tint":[0,0,0,16],"step":40,"base":"overview","tint_animation":[[0,0,0,16,120],[0,0,0,14,120],[0,0,0,12,120],[0,0,0,10,120],[0,0,0,8,120],[0,0,0,6,120],[0,0,0,4,120],[0,0,0,2,120],[0,0,0,0,40]]},{"visual_only":true}],[{"background":1,"camera":[4,4],"layers":[],"units":{"$":67},"tint":[0,0,0,0],"step":42,"base":"overview","$ms":240},{"visual_only":true}]],"$extra":true},"next_scene":"town:5","conditions":[{"label":"戰鬥勝利：敵方全滅"}],"lines":{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["殷劍平","face:1",1,"多謝前輩幫我們解圍，此恩此德，不知如何報答....",{"$m":376}],["鮮于超","face:5",0,"俺可不是幫你們。想必你們也聽過了的，俺身負血鎖鍊之咒，這血鎖鍊一時三刻便需吸取鮮血精魂，否則便熱如火炭，燎肌透骨，令俺求生不得求死不能。每逢此咒發作，俺難忍痛苦，只好揮刀殺人，讓這鎖鍊飽吸人血精魂。俺這『血鎖人屠』的名號，就是這樣來的。",{"$m":425}],["封寒月","face:2",1,"嗯，前輩的事情我也聽過一些，但道上以訛傳訛，都說前輩是身染瘋病，卻不知是這鎖鍊的緣故。",{"$m":385}],["鮮于超","face:5",0,"就為這鬼鎖鍊，俺數十年來不知造下多少殺孽。直至某日，俺在深山中遇上一群妖魔，當時血鎖鍊正使俺痛苦難當，索性就和那群妖魔拼了起來。待俺把牠們殺個乾淨之後，才發現發作不知何時已停息。原來這血鎖鍊可不挑剔，人血魔血它照單全收。",{"$m":425}],["封寒月","face:2",1,"啊，鮮于前輩在數年前忽然消聲暱聶跡，想是從此之後改弦易轍，專事斬妖除魔之務了。",{"$m":385}],["鮮于超","face:5",0,"說來慚愧。俺斬殺妖魔，全是為了平息這血鎖鍊發作之苦，與昔日殺人之時並沒什麼兩樣。不過能不再濫殺無辜，總是一樁好事。",{"$m":425}],["封寒月","face:2",1,"原來如此。鮮于前輩，您今後有何打算？",{"$m":385}],["鮮于超","face:5",0,"哈哈，能有什麼打算？俺今日不過是重遊舊地、憑弔一下以前的弟兄，也沒想到會遇上這些事情。想來之後仍是回到山陰野地，不時追獵妖魔以饗這鎖鍊，直到哪一天這毒咒消解為止。",{"$m":425}],["封寒月","face:2",1,"既是如此，鮮于前輩，以後就和我們同行如何？",{"$m":385}],["鮮于超","face:5",0,"咦，小姑娘何出此言？不怕哪天俺發作起來，第一個就殺了妳？",{"$m":425}],["封寒月","face:2",1,"如前輩所見，這些妖人已經和我們對上，來日惡戰無數，自是可期。彼等擅用召鬼邪術，想必妖魔是殺之不盡，豈不正合前輩所需？",{"$m":385}],["鮮于超","face:5",0,"哈哈哈，原來如此。俺跟著你們討伐妖人，你們可以多個幫手，俺也可保將來不缺妖魔可殺，可謂兩相得利。小姑娘，妳可是這個意思？",{"$m":425}],["封寒月","face:2",10,"是啊。前輩一身神力武藝，正是這些妖魔鬼物的剋星，若前輩肯慨然相助，那真是再好不過了。",{"$m":385}],["鮮于超","face:5",0,"小姑娘倒會打算盤。也罷，俺浪跡天涯已久，到哪兒都是一樣的。只要你們不怕俺這名號惹來麻煩，幫你們殺殺這些兔崽子倒也無妨。",{"$m":425}],["封寒月","face:2",1,"前輩，您的意思是答應了？",{"$m":385}],["殷劍平","face:1",1,"多..多謝前輩！",{"$m":376}],["上官遠","face:4",1,"既是如此，咱們趕快下山，找間酒樓擺酒設宴，歡迎鮮于前輩如何？",{"$m":396}],["封寒月","face:2",1,"上官大哥，說得這麼好聽，其實是你自己想喝酒吧！",{"$m":385}],["上官遠","face:4",1,"不好意思，在這裡耽擱了這麼久，為兄肚裡的酒蟲是有點蠢蠢欲動了....",{"$m":396}],["鮮于超","face:5",0,"哈哈哈，如今思來，俺也好久沒有痛飲一番了。嗯，由此下山後一路東行，便可抵達太原城。太原雖非以酒出名，但酒店茶館林立，要喝的話到那裡再喝個痛快。",{"$m":425}],["殷劍平","face:1",1,"那就請前輩帶路了。",{"$m":376}],["鮮于超","face:5",0,"嗯，跟我來！",{"$m":425}]]}},{"id":"event-3","kind":"defeat","title":{"$":68},"steps":[{"line":0,"scene":{"background":1,"camera":null,"focus":[6,12],"layers":[],"units":{"$":39},"step":0,"base":"overview"}}],"conditions":[{"label":{"$":68}},{"label":"戰鬥敗北：鮮于超被擊倒"}],"lines":[{"speaker":"鮮于超","speaker_key":"face:5","side":1,"text":"小兄弟，我幫不了你們啦！你們就....自己當心.......","portrait":{"$m":426}}]}],"$mediaVersion":"3ccf0c4ec4f8","$pool":[[{"id":0,"frame":0,"mode":"held"}],{"id":0,"direction":1},{"id":2,"direction":1},{"id":23,"direction":2},[{"$":1},{"$":2},{"id":3,"direction":1},{"$":3}],[{"$":1},{"$":2},{"$":6},{"$":3}],{"id":3,"direction":0},[{"$":8},{"$":9},{"$":6},{"$":3}],{"id":0,"direction":0},{"id":2,"direction":0},[{"$":8},{"$":9},{"$":6},{"$":11},{"$":12},{"id":9,"visible":true,"group":1},{"id":10,"visible":true,"group":1},{"id":13,"visible":true,"group":1},{"id":14,"visible":true,"group":1},{"$":13},{"$":14},{"$":15},{"$":3}],{"id":5,"visible":true,"group":1},{"id":6,"visible":true,"group":1},{"id":17,"visible":true,"group":1},{"id":18,"visible":true,"group":1},{"id":21,"visible":true,"group":1},[[240,240,240,16,40],[208,208,208,16,40],[208,208,208,16,40],[176,176,176,16,40],[176,176,176,16,40],[144,144,144,16,40],[144,144,144,16,40],[112,112,112,16,40],[112,112,112,16,40],[80,80,80,16,40],[80,80,80,16,40],[48,48,48,16,40],[48,48,48,16,40],[16,16,16,16,40],[16,16,16,16,40],[0,0,0,16,40],[0,0,0,16,40]],[{"$":8},{"$":9},{"$":6},{"$":11},{"$":12},{"$":18},{"$":19},{"$":20},{"$":21},{"$":13},{"$":14},{"$":15},{"$":3}],{"id":9,"visible":true,"group":1,"x":25,"y":11,"direction":2},{"id":10,"visible":true,"group":1,"x":22,"y":9,"direction":2},{"i