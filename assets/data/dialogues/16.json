$":242},{"$":243},{"$":244},{"$":256},{"$":245}],{"id":65,"visible":false,"group":1},{"line":4,"scene":{"background":1,"camera":[7,4],"layers":{"$":248},"units":{"$":255},"step":25,"base":"overview"}},{"line":5,"scene":{"background":1,"camera":[7,4],"layers":{"$":248},"units":{"$":255},"step":26,"base":"overview"}},{"visual_only":true,"scene":{"background":1,"camera":[7,4],"layers":{"$":248},"units":{"$":255},"tint":[0,0,0,16],"step":27,"base":"overview","tint_animation":{"$":246}}},{"visual_only":true,"scene":{"background":1,"camera":[7,4],"layers":[{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"$":7},{"$":8},{"$":9},{"$":81}],"units":{"$":261},"tint":[0,0,0,0],"step":39,"base":"overview"}},[{"id":0,"x":12,"y":45,"visible":true,"group":1,"direction":1},{"id":1,"visible":false,"group":1,"direction":2},{"id":2,"x":13,"y":44,"visible":true,"group":1,"direction":1},{"id":3,"x":13,"y":46,"visible":true,"group":1,"direction":1},{"id":4,"x":13,"y":47,"visible":true,"group":1,"direction":1},{"id":5,"x":14,"y":44,"visible":true,"group":1,"direction":1},{"id":6,"x":13,"y":48,"visible":true,"group":1,"direction":1},{"id":7,"x":14,"y":45,"visible":true,"group":1,"direction":1},{"id":8,"x":14,"y":46,"visible":true,"group":1,"direction":1},{"id":9,"visible":true,"group":1,"x":14,"y":47,"direction":1},{"$":190},{"$":191},{"$":192},{"$":193},{"$":194},{"$":195},{"$":196},{"$":197},{"$":198},{"$":199},{"$":200},{"$":201},{"$":202},{"$":203},{"$":204},{"$":205},{"$":206},{"$":207},{"$":208},{"$":209},{"$":210},{"$":211},{"$":212},{"$":213},{"$":214},{"$":215},{"$":216},{"$":217},{"$":218},{"$":219},{"$":220},{"$":221},{"$":222},{"$":223},{"$":224},{"$":225},{"$":226},{"$":227},{"$":228},{"$":229},{"$":230},{"$":231},{"$":232},{"$":233},{"$":234},{"$":235},{"$":236},{"$":237},{"$":238},{"$":239},{"$":240},{"$":241},{"$":242},{"$":243},{"$":244},{"$":256},{"$":245}],{"visual_only":true,"scene":{"background":1,"camera":[7,41],"layers":{"$":263},"units":{"$":261},"tint":[0,0,0,0],"step":41,"base":"overview","tint_animation":{"$":250}}},[{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"$":7},{"$":8},{"$":9},{"$":84}],{"line":6,"scene":{"background":1,"camera":[7,41],"layers":{"$":263},"units":{"$":261},"step":42,"base":"overview"}},{"line":7,"scene":{"background":1,"camera":[7,41],"layers":{"$":263},"units":{"$":261},"step":43,"base":"overview"}},{"line":8,"scene":{"background":1,"camera":[7,41],"layers":{"$":263},"units":{"$":261},"step":44,"base":"overview"}},{"label":"戰鬥勝利：敵方全滅"},{"speaker":"韓無砂","speaker_key":"face:34","side":1,"text":"哼，你們且別得意，現在還沒分出勝負....齊祀的『玄陰搜魂陣』就快完成了，屆時不只是你們幾個，方圓數十里之內，任誰都得變成有軀無魂的活死人。","portrait":{"$m":409}},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"這裡有禁軍壓陣，待會我們便請韋統領派兵拆了祭天塔，我倒看看那齊祀有多大本事。","portrait":{"$m":389}},{"speaker":"韓無砂","speaker_key":"face:34","side":1,"text":"嘿嘿嘿，且看你們能否動得了祭天塔。少陪了！","portrait":{"$m":407}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"韓無砂！別逃......","portrait":{"$m":382}},{"speaker":"上官遠","speaker_key":"face:4","side":1,"text":"殷老弟，咱們不急著追，就算跑得了韓無砂，卻跑不了祭天塔。","portrait":{"$m":396}},{"speaker":"封寒月","speaker_key":"face:2","side":1,"text":"只怕韓無砂並非空言恫嚇，此刻已過丑時，正是陰氣最盛之時，我擔心那搜魂陣即將發動，殷大哥，我們還是快去祭天塔瞧瞧。","portrait":{"$m":385}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"統領大人，此地之圍已解，請您派遣五十名兵士隨我們前往祭天塔，阻止齊祀完成那搜魂大陣。","portrait":{"$m":376}},{"speaker":"韋勝","speaker_key":"face:20","side":0,"text":"五十名未免太過小氣。待會韋某也和你們同去，調動全城禁軍包圍祭天塔，絕不能讓那齊祀逃了。","portrait":{"$m":477}},{"speaker":"紫楓","speaker_key":"face:3","side":1,"text":"塔內只怕有妖魔到處橫行，韋統領您率軍在外掠陣即可，登塔之事由我們負責便是。","portrait":{"$m":428}},{"speaker":"韋勝","speaker_key":"face:20","side":0,"text":"好說，諸位請先休整片刻，待人馬調集妥當，咱們再一起前往祭天塔。請！","portrait":{"$m":477}},"官兵陣亡6人以上",[{"$":2},{"$":3},{"$":4},{"$":5},{"$":6},{"$":7},{"$":8},{"$":9},{"id":9,"frame":-1,"mode":"held"},{"$":140}]]}