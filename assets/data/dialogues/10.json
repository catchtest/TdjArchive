roup":1},[{"$":115},{"$":107},{"$":108},{"$":109},{"$":110},{"$":111},{"$":112},{"$":70},{"$":71},{"$":72},{"$":73},{"$":74},{"$":75},{"$":76},{"$":77},{"$":78},{"$":79},{"$":80},{"$":81},{"$":82},{"$":83},{"$":84},{"$":85},{"$":86},{"$":87},{"$":88},{"$":89},{"$":90},{"$":91},{"$":92},{"$":93},{"$":94},{"$":95},{"$":96},{"$":97},{"$":98},{"$":99},{"$":100},{"$":101},{"$":113},{"$":102},{"$":103},{"$":104}],{"id":0,"x":2,"y":6,"visible":true,"group":1,"direction":0},{"id":0,"x":-5,"y":6,"visible":true,"group":1,"direction":1},{"id":2,"visible":true,"group":1,"x":-6,"y":6,"direction":1},{"id":3,"visible":true,"group":1,"x":-5,"y":7,"direction":1},{"id":4,"visible":true,"group":1,"x":-4,"y":9,"direction":1},{"id":5,"visible":true,"group":1,"x":-5,"y":8,"direction":1},{"id":6,"visible":true,"group":1,"x":-4,"y":7,"direction":1},[{"id":0,"from":[2,6],"$ms":2100,"gesture":true},{"id":2,"from":[1,6],"$ms":2100,"gesture":true},{"id":3,"from":[2,7],"$ms":2100,"gesture":true},{"id":4,"from":[3,9],"$ms":2100,"gesture":true},{"id":5,"from":[2,8],"$ms":2100,"gesture":true},{"id":6,"from":[3,7],"$ms":2100,"gesture":true}],{"label":"戰鬥勝利：敵方全滅"},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"真胤大師，現下可還能察覺妖人的蹤跡？","portrait":{"$m":463}},{"speaker":"真胤","speaker_key":"face:6","side":1,"text":"現在連半絲妖氣也無，剛才的追跡術也毫無收穫，想是敵方都已離開此地。","portrait":{"$m":528}},{"speaker":"封寒月","speaker_key":"face:2","side":0,"text":"殷大哥，既然敵蹤已失，咱們不妨先出了太行山，再轉向南往嵩山一趟如何？","portrait":{"$m":472}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"在下久聞中嶽之名，早就想一睹名山風采，只是此刻並非遊山玩水的時機...","portrait":{"$m":463}},{"speaker":"封寒月","speaker_key":"face:2","side":0,"text":"嘻嘻，殷大哥想到哪去了，我是想先回四象門本門一趟，向師父請教一下迄今諸多不解之處。","portrait":{"$m":480}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"啊，原來貴派本門就在嵩山？","portrait":{"$m":463}},{"speaker":"封寒月","speaker_key":"face:2","side":0,"text":"是啊，嵩山磐天嶺，正是我四象門所在。我師父修為高深是不用說的，他老人家閱歷見聞均極廣博，有關這些奇物異人之事，正可向他問個清楚。","portrait":{"$m":480}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"可是我記得在襄陽相遇之初，妳師兄正四處派人捉拿妳，現下忽然回返本門，不會有何不妥麼？","portrait":{"$m":463}},{"speaker":"封寒月","speaker_key":"face:2","side":0,"text":"這倒不用擔心。我大師兄是帶藝投師，劍法上的造詣不差，但他於術法的天資有限，教出來的徒兒自然可想而知，單獨時我或許還怕他們三分，但現在可就不足為懼了。","portrait":{"$m":480}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"話雖如此，我們總還算是登門拜訪，儘量以不生事為宜。要是雙方起了衝突，對尊師也很是不敬。","portrait":{"$m":463}},{"speaker":"封寒月","speaker_key":"face:2","side":0,"text":"我知道啦，回返本門之後，我言語上多收斂些便是。只是人不犯我我不犯人，如果我大師兄欺人太甚，也不用對他太客氣。","portrait":{"$m":480}},{"speaker":"殷劍平","speaker_key":"face:1","side":1,"text":"那便見機行事了。嗯，既然決定如此，咱們這就動身吧！","portrait":{"$m":463}},[{"$":115},{"$":107},{"$":108},{"$":109},{"$":110},{"$":111},{"$":112},{"$":70},{"$":71},{"$":72},{"$":73},{"$":74},{"$":75},{"$":76},{"$":77},{"$":78},{"$":79},{"$":80},{"$":81},{"$":82},{"$":83},{"$":84},{"$":85},{"$":86},{"$":87},{"$":88},{"$":89},{"$":90},{"$":91},{"$":92},{"$":93},{"$":94},{"$":95},{"$":96},{"$":97},{"$":98},{"$":99},{"$":100},{"$":101},{"$":68},{"$":102},{"$":103},{"$":104}],[{"$":106},{"$":107},{"$":108},{"$":109},{"$":110},{"$":111},{"$":112},{"$":70},{"$":71},{"$":72},{"$":73},{"$":74},{"$":75},{"$":76},{"$":77},{"$":78},{"$":79},{"$":80},{"$":81},{"$":82},{"$":83},{"$":84},{"$":85},{"$":86},{"$":87},{"$":88},{"$":89},{"$":90},{"$":91},{"$":92},{"$":93},{"$":94},{"$":95},{"$":96},{"$":97},{"$":98},{"$":99},{"$":100},{"$":101},{"$":68},{"$":102},{"$":103},{"$":104}]]}