4,4],[],{"$":61},{"id":0},113,"configured"]},{"line":33}],[{"$r":[0,1,[34,4],[],{"$":61},{"id":0},114,"configured"]},{"line":34}],[{"$r":[0,1,[2,4],[],{"$":61},{"id":0},116,"configured"]},{"line":35}],[{"$r":[5,1,[2,4],[],{"$":63},{"id":0},123,"configured",240]},{"visual_only":true}]],"$extra":true},[{"label":"戰鬥前的開場劇情"}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["封寒月","face:2",1,"好古老的棧道....咱們到了哪裡了？",{"$m":31}],["鮮于超","face:5",1,"咱們一路向東行而穿山入嶺，若依方位來算，此地應該是在太行山中。",{"$m":99}],["上官遠","face:4",1,"沒想到深山中竟有如此棧道。由木色看來，這棧道的年代已十分久遠。",{"$m":52}],["鮮于超","face:5",1,"戰國之時各國互相攻伐，為了便利行軍運補，在天險峻嶺搭築棧道乃是常事。看來這條棧道通抵東西兩側，穿山越嶺極是便利，妖人必是想經由此路逃脫。",{"$m":99}],["殷劍平","face:1",1,"真胤大師，那妖人還在附近嗎？",{"$m":11}],["真胤","face:6",1,"附近的確是有妖氣，但和先前的不太一樣。自從咱們離開霧谷之後，對方的妖氣就時有時無，這樣一路追下來，也不知道有沒有追錯方向。",{"$m":123}],["殷劍平","face:1",1,"倘若如此，那也是沒辦法的事。",{"$m":11}],["真胤","face:6",1,"這批妖人的確不尋常，貧僧的式鬼追跡術從不失手，沒想到這回卻給對方輕易兔脫，之前十幾年的修煉都算白費了。",{"$m":123}],["封寒月","face:2",1,"大師身為秘宗僧侶，卻又精通陰陽師的式鬼之術，當真是博學廣聞。",{"$m":31}],["真胤","face:6",1,"說來慚愧，貧僧在入佛門之前，曾是個恃法為惡的陰陽師。後來蒙師尊開恩收為門下，既傳貧僧秘宗破魔心法，又允貧僧保留陰陽道的道行。師尊言道，只要用於正途，召鬼之術亦非邪道，這教誨貧僧一直銘記在心。",{"$m":123}],["封寒月","face:2",1,"原來如此。",{"$m":31}],["真胤","face:6",1,"此地靈瘴混雜，仙魔難辨，大夥不妨先在此歇息，待貧僧放幾隻式鬼到附近搜索之後，再作打算....等等！",{"$m":123}],["殷劍平","face:1",1,"大師，怎麼了？",{"$m":11}],["真胤","face:6",1,"有道妖氣正向此地而來，大家小心！",{"$m":123}],["燕明蓉","face:8",0,"你們....也是和他們一夥的？也是來攔截我的嗎？",{"$m":128}],["殷劍平","face:1",1,"在下不知姑娘所指為何，不過瞧妳傷勢不輕，讓在下以術法為姑娘略作醫治如何？",{"$m":11}],["燕明蓉","face:8",0,"......不用了，我還能走。讓我過去....",{"$m":128}],["真胤","face:6",1,"且慢！此女身上妖氣頗重，說不定是敵方一夥，貧僧以為，還是先問清楚了再作打算。",{"$m":122}],["紫楓","face:3",1,"真胤大師思慮深遠周到，小女子深感佩服。不過此女雖然身帶妖氣，但她應非妖邪一流，咱們應無為難她的必要。",{"$m":106}],["殷劍平","face:1",1,"是啊，我也覺得她看起來不像惡徒....",{"$m":11}],["真胤","face:6",1,"既然兩位都這麼認為，貧僧自無異議....咦！又有多道妖氣向此地而來！",{"$m":123}],["紫楓","face:3",1,"....這回應該真的是敵人了，大夥準備應戰。",{"$m":106}],["燕明蓉","face:8",0,"啊！他們..他們追來了嗎？",{"$m":128}],["殷劍平","face:1",1,"他們？",{"$m":11}],["夏侯儀","face:9",0,"哼，小鬼頭，這回妳跑不掉了吧。",{"$m":129}],["燕明蓉","face:8",0,"....求你們讓我過去，我打不過那人....",{"$m":128}],["殷劍平","face:1",1,"諸位，咱們讓路給她過去吧。",{"$m":11}],["燕明蓉","face:8",0,"謝、謝謝你們！我會記住你們的恩惠的！....",{"$m":128}],["夏侯儀","face:9",0,"哼，竟敢和我作對，算你們有膽....等等！瞧你們面貌人數，倒和他們描述的頗為相符，莫非在霧谷中就是你們......",{"$m":130}],["真胤","face:6",1,"哼！閣下果然是妖人一夥！",{"$m":122}],["封寒月","face:2",1,"你知道就好，冥皇鄲陰便是在霧谷被我們殺得大敗而逃，你也想來試看看麼？",{"$m":31}],["夏侯儀","face:9",0,"果真是你們！哈哈哈，有趣有趣，我的確想試試你們的本事！",{"$m":129}],["上官遠","face:4",1,"此人金髮碧眼，髖骨高聳，面貌極是奇異，莫非是.....修練了什麼妖術魔功之故？",{"$m":52}],["鮮于超","face:5",1,"非也，此人乃是西域胡人，可能有波斯血統。聽說西土的妖術有其獨到之處，既然這人也精通妖法，咱們可得多小心些。",{"$m":99}],["紫楓","face:3",1,"這人眼目隱含剎氣，兼之身上邪氣極重，看來我們是非小心不可了。",{"$m":106}],["夏侯儀","face:9",0,"哼！自命清高的正派偽君子。給我殺！",{"$m":129}]]},{}],["event-5","turn",{"$":66},[{"$r":[13,0,{"$r":[17,1,null,[4,8],[],{"$":63},1,"overview"]}]},{"$r":[13,1,{"$r":[17,1,null,[4,8],[],{"$":63},2,"overview"]}]},{"$r":[13,2,{"$r":[17,1,null,[4,8],[],{"$":63},3,"overview"]}]},{"visual_only":true,"scene":{"background":1,"camera":null,"focus":[4,8],"layers":[],"units":{"$":67},"tint":[208,208,160,16],"step":5,"base":"overview","tint_animation":[[208,208,160,16,80],[208,208,160,16,80],[176,176,128,16,80],[176,176,128,16,80],[144,144,112,16,80],[144,144,112,16,80],[112,112,80,16,80],[112,112,80,16,80],[80,80,64,16,80],[80,80,64,16,80],[48,48,32,16,80],[48,48,32,16,80],[16,16,16,16,80],[16,16,16,16,80],[0,0,0,16,80],[0,0,0,16,40]]}},{"$r":[13,3,{"$r":[18,1,null,[4,8],[],{"$":67},[0,0,0,16],6,"overview"]}]},{"$r":[13,4,{"$r":[18,1,null,[40,8],[],{"$":70},[0,0,0,16],9,"overview"]}]},{"$r":[13,5,{"$r":[18,1,null,[40,8],[],{"$":70},[0,0,0,16],10,"overview"]}]}],[{"label":{"$":66}}],{"$keys":["speaker","speaker_key","side","text","portrait"],"$rows":[["夏侯儀","face:9",1,"這就是擊倒鄲陰的實力嗎？真是領教了，哈！哈！哈！",{"$m":129}],["封寒月","face:2",0,"你這是什麼意思？",{"$m":35}],["夏侯儀","face:9",1,"哼，就你們這些本事，還不配讓我親自出手。出來吧，我的僕人們！",{"$m":129}],["夏侯儀","face:9",1,"就讓這些來陪你們玩玩吧，告辭了！",{"$m":129}],["封寒月","face:2",0,"真氣人，如此的小看我們！",{"$m":35}],["殷劍平","face:1",0,"沒辦法，先解決眼前的敵人再說吧！",{"$m":11}]]},{}],["event-2-path-1","victory","戰鬥勝利（懸天古徑曾擊