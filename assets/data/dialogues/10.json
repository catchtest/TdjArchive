,{"line":16}],[{"$r":[0,1,[0,4],[],{"$":118},null,51,"overview"]},{"line":17}],[{"$r":[0,1,[0,4],[],{"$":118},null,52,"overview"]},{"line":18}],[{"$r":[0,1,[0,4],[],{"$":109},null,54,"overview"]},{"line":19}],[{"$r":[0,1,[0,4],[],{"$":109},null,55,"overview"]},{"line":20}],[{"$r":[0,1,[0,4],[],{"$":109},null,56,"overview"]},{"line":21}],[{"$r":[0,1,[0,4],[],{"$":109},null,57,"overview"]},{"line":22}],[{"$r":[0,1,[0,4],[],{"$":109},null,58,"overview"]},{"line":23}],[{"$r":[0,1,[0,4],[],{"$":109},null,59,"overview"]},{"line":24}],[{"$r":[0,1,[0,4],[],{"$":109},null,60,"overview"]},{"line":25}],[{"$r":[0,1,[0,4],[],{"$":109},null,61,"overview"]},{"line":26}],[{"$r":[0,1,[0,4],[],{"$":109},null,62,"overview"]},{"line":27}],[{"$r":[6,1,[0,4],[],{"$":120},null,70,"overview",{"$":127},2520]},{"visual_only":true}],[{"$r":[15,1,[0,4],[],{"$":120},[0,0,0,16],null,71,"overview",{"$":108}]},{"visual_only":true}],[{"$r":[19,1,[0,4],[],{"$":120},[0,0,0,0],null,73,"overview",240]},{"visual_only":true}]],"$extra":true},[{"$":128},{"label":"懸天古徑曾擊倒夏侯儀"}],[{"$r":[4,"夏侯儀","face:9",0,"嘿，果然不是易與之輩。既然如此，我也不必再客氣了，讓你們嚐嚐我的『非天炎滅』..",{"$m":130}]},{"$r":[4,"殷劍平","face:1",1,"非天禁法？那不是傳聞中的兩大禁法之一麼？",{"$m":18}]},{"$r":[4,"封寒月","face:2",1,"非天禁法威力雖大，但亦會損你魂魄真元，你和我們並無仇恨，何苦如此性命相拼？",{"$m":33}]},{"$r":[4,"夏侯儀","face:9",0,"我生平最恨你們這種自以為是的偽君子，只要能殺盡你們這些正派中人，這條性命又何足惜？",{"$m":130}]},{"$r":[4,"封寒月","face:2",1,"既是如此，我就以禁法對禁法。接我這一招『絕天冥煞』...",{"$m":35}]},{"$r":[4,"夏侯儀","face:9",0,"妳會『絕天禁法』？『絕天禁法』威力更勝非天禁法，但一用便魂魄滅散、永不超生，妳真的敢用？",{"$m":130}]},{"$r":[4,"封寒月","face:2",1,"你敢傷我的朋友，我就先一擊斃了你。你有不顧性命要報的仇，我也有我甘願捨命保護的人，我們同是偏激乖張之輩，你該明白我不是在說笑。",{"$m":35}]},{"$r":[4,"夏侯儀","face:9",0,"想要捨命保護的人....麼。呵呵..哈哈..哈哈哈哈！",{"$m":129}]},{"$r":[4,"封寒月","face:2",1,"........這好笑麼？",{"$m":35}]},{"$r":[4,"夏侯儀","face:9",0,"....不，妳說得對。與其如此行屍走肉的為復仇而活，倒不如像妳這樣，用絕天禁法捨命一擊的好。看在姑娘賜教的份上，今天就放你們一馬罷！....後會有期了。",{"$m":129}]},{"$r":[4,"殷劍平","face:1",1,"封姑娘，剛才此人狂言要用禁法，只怕並非虛言，多虧妳再次巧計退敵，咱們才免得此禍。",{"$m":11}]},{"$r":[4,"封寒月","face:2",0,"不，我剛才也是說真的。我想他是明白了我的心思，因此才退走的吧。不過