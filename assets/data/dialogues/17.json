:84},{"$":85},{"$":86},{"$":87},{"$":88},{"$":89},{"$":90},{"$":91},{"$":92},{"$":93},{"$":94},{"$":95},{"$":96},{"$":97},{"$":98},{"$":99},{"$":100},{"$":101},{"$":102},{"$":103},{"$":104},{"$":105},{"$":106},{"$":107},{"$":108},{"$":109},{"$":110}],[240,240,240,16],{"$":20},142,"configured",[[240,240,240,16,40],[208,208,208,16,40],[208,208,208,16,40],[176,176,176,16,40],[176,176,176,16,40],[144,144,144,16,40],[144,144,144,16,40],[112,112,112,16,40],[112,112,112,16,40],[80,80,80,16,40],[80,80,80,16,40],[48,48,48,16,40],[48,48,48,16,40],[16,16,16,16,40],[16,16,16,16,40],[0,0,0,16,40],[0,0,0,16,40]]]},{"visual_only":true}],[{"$r":[4,1,[0,42],{"$":0},{"$":111},{"$":20},149,"configured",240]},{"visual_only":true}]],"$extra":true},[{"label":"戰鬥前的開場劇情"}],{"$keys":["speaker","speaker_key","side","text"],"$rows":[["上官遠","face:4",1,"啊！那是....王大人！",{"portrait":{"$m":57}}],["上官遠","face:4",1,"王大人！王大人！請您振作些.....",{"portrait":{"$m":57}}],["王謙","face:26",0,"啊，是....上官都尉啊。我是不成的了，這裡....這裡面全是妖魔，你要小心......",{"portrait":{"$m":198}}],["上官遠","face:4",1,"我的朋友們都來了，妖魔奈何不了我們的。您振作一點，我馬上救您出去！",{"portrait":{"$m":57}}],["王謙","face:26",0,"啊，他們....來了嗎？....別管我，快去阻住齊祀施法....凶星昊熒將至天頂，此刻正是人間陰煞鬼氣最盛之時，那搜魂大法要是在此時完成，後果不堪設想....快、快去..去阻....唔！",{"portrait":{"$m":198}}],["上官遠","face:4",1,"王大人！王大人！....沒想到我找您幫忙，結果卻害了您的性命....",{"portrait":{"$m":57}}],["殷劍平","face:1",1,"上官兄，這不是你的錯....無論如何，咱們唯有趕快登塔找到齊祀，才能為王大人和太和殿前死難的禁軍弟兄們報仇。",{"portrait":{"$m":17}}],["上官遠","face:4",1,"殷賢弟，你說得對，在這裡難過也於事無補。王大人，請您安心吧！我今天殺遍這座他媽的鳥塔，也一定要抓到齊祀這狗崽子！咱們走！",{"portrait":{"$m":199}}],["封寒月","face:2",1,"這才像我們的上官大哥！",{"portrait":{"$m":47}}],["燕明蓉","face:8",0,"呼！呼！呼！這祭天塔還真是高 . . .爬到這裡也該快到塔頂了吧！",{"portrait":{"$m":177}}],["燕明蓉","face:8",0,"天...天啊...還...還有那麼高...",{"portrait":{"$m":181}}],["韓千秀","face:7",0,"蓉妹妹妳怎麼了？",{"portrait":{"$m":136}}],["燕明蓉","face:8",0,"韓姊姊妳看看嘛...爬了這麼久了，這祭天塔還那麼高...人家...人家...都快走不動了......",{"portrait":{"$m":177}}],["鮮于超","face:5",0,"傻丫頭！妳爬的那麼快，當然會累了！別忘了齊祀還在塔頂上喔！",{"portrait":{"$m":99}}],["燕明蓉","face:8",0,"可是...可是...人家想早點逮到齊祀那老傢伙，好好